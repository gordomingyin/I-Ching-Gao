\n\n\/* ── TILES ── *\/\n.T{\n  display:flex;align-items:center;justify-content:center;\n  font-size:11px;cursor:pointer;color:var(--t2);\n  border:1px solid #0e0e10;\n  transition:color 0.1s,background 0.1s;\n  user-select:none;line-height:1;overflow:hidden;\n  background:var(--bg);\n}\n.T:hover{color:var(--t1);background:#060608;}\n.T:active{color:var(--yang);background:#0a0a0c;}\n.T.on{color:var(--yang);}\n.T.on-yin{color:var(--yin);}\n\n.hx{font-size:11px;}\n.hx.ahx{color:var(--yang);}\n\n.tri-t{font-size:17px;}\n.tri-t.atb{color:var(--yang);}\n\n.yao-t{font-size:15px;}\n\n\/* ── CENTER ── *\/\n#center{\n  grid-column:3\/11;\n  grid-row:4\/10;\n  display:flex;align-items:center;justify-content:center;\n  background:var(--bg);\n  position:relative;\n  border:1px solid #0a0a0c;\n  overflow:hidden;\n}\n\/* make it square by aspect-ratio trick with js *\/\n\n#ghost{\n  position:absolute;\n  font-family:'Zhi Mang Xing',cursive;\n  font-size:min(18vw,85px);\n  color:rgba(200,169,110,0.04);\n  pointer-events:none;user-select:none;\n  transition:color 0.6s;\n}\n#ghost.vivid{color:rgba(200,169,110,0.07);}\n\n#flash-target{\n  position:absolute;\n  font-family:'Zhi Mang Xing',cursive;\n  font-size:min(22vw,105px);\n  line-height:1;color:#fff;\n  text-shadow:0 0 40px rgba(200,169,110,0.9),0 0 80px rgba(200,169,110,0.3),0 0 2px #fff;\n  pointer-events:none;user-select:none;\n  opacity:0;transition:opacity 0.08s;z-index:20;\n}\n#flash-target.show{opacity:1;}\n\n\/* ── YAO LASER DISPLAY ── *\/\n#yao-display{\n  display:flex;flex-direction:column;gap:6px;\n  position:relative;z-index:2;\n  width:72%;\n}\n.yl{height:8px;width:100%;cursor:pointer;display:flex;align-items:center;flex-shrink:0;}\n.yl:hover{opacity:0.7;}\n\n\/* YANG laser line *\/\n.yl-yang{\n  width:100%;height:4px;\n  background:linear-gradient(90deg,transparent 0%,var(--laser-yang) 15%,var(--laser-yang) 85%,transparent 100%);\n  border-radius:2px;\n  box-shadow:0 0 12px var(--laser-yang),0 0 4px var(--laser-yang),0 0 20px rgba(200,169,110,0.3);\n  position:relative;\n}\n.yl-yang::before{\n  content:'';position:absolute;top:1px;left:10%;width:80%;height:1px;\n  background:rgba(255,255,220,0.6);border-radius:1px;\n}\n\n\/* YIN laser line (two segments) *\/\n.yl-yin{\n  width:100%;display:flex;gap:18%;height:4px;\n}\n.yl-yin-b{\n  flex:1;height:4px;\n  background:linear-gradient(90deg,transparent 0%,var(--laser-yin) 20%,var(--laser-yin) 80%,transparent 100%);\n  border-radius:2px;\n  box-shadow:0 0 10px var(--laser-yin),0 0 3px var(--laser-yin),0 0 16px rgba(61,110,138,0.3);\n  position:relative;\n}\n.yl-yin-b::before{\n  content:'';position:absolute;top:1px;left:15%;width:70%;height:1px;\n  background:rgba(180,220,255,0.5);border-radius:1px;\n}\n\n.yl-blank{width:100%;height:4px;border:1px dashed #141418;border-radius:2px;opacity:0.25;}\n.yl-gap{height:5px;width:100%;}\n\n\/* virtual node indicator *\/\n#vnode{\n  display:flex;align-items:center;justify-content:center;\n  height:16px;\n  font-size:11px;\n  color:rgba(200,169,110,0.15);\n  letter-spacing:0.1em;\n  transition:all 0.3s;\n}\n#vnode.active{color:rgba(200,169,110,0.5);text-shadow:0 0 8px rgba(200,169,110,0.4);}\n\n\/* ── CONTROL PANEL ── *\/\n#ctrl{\n  flex-shrink:0;\n  display:grid;\n  grid-template-columns:auto 1fr auto;\n  background:var(--s0);\n  border-top:1px solid var(--bd);\n}\n\n#ctrl-left{\n  display:flex;flex-direction:column;\n  padding:3px;gap:2px;\n  border-right:1px solid var(--bd);\n}\n.flip-row{display:flex;gap:1px;}\n.fb{\n  font-size:12px;background:transparent;border:1px solid var(--bd);\n  color:var(--t2);cursor:pointer;padding:3px 4px;border-radius:1px;\n  transition:all 0.15s;line-height:1;min-width:22px;text-align:center;\n}\n.fb:hover{color:var(--yang);border-color:rgba(200,169,110,0.25);}\n.fb:active{color:var(--jade);}\n\n#ctrl-mid{\n  display:flex;flex-direction:column;\n  padding:3px 5px;min-width:0;\n}\n#icon-row{display:flex;align-items:center;gap:4px;}\n#hex-icon{\n  font-family:'Zh