}\n#reset-btn{font-size:13px;background:none;border:1px solid var(--bd);color:var(--t2);cursor:pointer;padding:3px 7px;border-radius:1px;transition:all 0.2s;flex-shrink:0;}\n#reset-btn:hover{color:var(--ember);}\n\n#ctrl-right{\n  display:flex;flex-direction:column;padding:3px;gap:2px;\n  border-left:1px solid var(--bd);min-width:50px;\n}\n.ds{display:flex;gap:2px;}\n.db{font-family:'Ma Shan Zheng',cursive;font-size:11px;background:transparent;color:var(--t2);border:1px solid var(--bd);padding:1px 4px;cursor:pointer;border-radius:1px;transition:all 0.2s;}\n.db.on{color:var(--yang);border-color:rgba(200,169,110,0.3);background:rgba(200,169,110,0.05);}\n#prog{display:flex;gap:2px;flex-wrap:wrap;}\n.pn{width:5px;height:5px;border-radius:1px;border:1px solid var(--bd);background:var(--s1);transition:all 0.3s;}\n.pn.done{background:var(--jade);border-color:var(--jade);}\n.pn.cur{background:var(--yang);border-color:var(--yang);animation:blink 1s infinite;}\n#stt{font-family:'Space Mono',monospace;font-size:7px;border:1px solid var(--bd);padding:1px 3px;border-radius:1px;color:var(--t2);transition:all 0.3s;text-align:center;}\n#stt.sf{color:#5ab8d8;}\n#stt.si{color:var(--yang);}\n#stt.sm{color:var(--jade);}\n#stt.se{color:var(--ember);}\n.score-row{display:flex;gap:4px;align-items:center;}\n.sc-v{font-family:'Space Mono',monospace;font-size:10px;font-weight:700;color:var(--yang);}\n.sc-v.pop{animation:spop 0.4s ease-out;}\n@keyframes spop{0%{transform:scale(1)}40%{transform:scale(1.4);color:var(--jade)}100%{transform:scale(1)}}\n.sc-l{font-family:'Ma Shan Zheng',cursive;font-size:8px;color:var(--t2);}\n.sc-item{display:flex;flex-direction:column;align-items:center;}\n.spd-trk{height:2px;background:var(--bd);border-radius:1px;overflow:hidden;width:100%;}\n.spd-fill{height:100%;background:var(--jade);border-radius:1px;transition:width 0.5s,background 0.5s;}\n#fb{font-family:'Ma Shan Zheng',cursive;font-size:8px;color:var(--t2);text-align:center;transition:color 0.3s;}\n#fb.act{color:#b8922a;}\n#fb.ok{color:var(--jade);}\n\n\/* ── ERROR ── *\/\n#eov{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,0.98);backdrop-filter:blur(12px);display:flex;flex-direction:column;align-items:center;overflow-y:auto;padding:14px 12px 80px;gap:10px;}\n#eov.hidden{display:none;}\n.et{font-family:'Zhi Mang Xing',cursive;font-size:28px;color:var(--ember);text-shadow:var(--ge);text-align:center;}\n.cmp-row{display:flex;align-items:center;gap:16px;justify-content:center;flex-wrap:wrap;}\n.cbox{text-align:center;}\n.clbl{font-family:'Ma Shan Zheng',cursive;font-size:10px;color:var(--t2);margin-bottom:3px;}\n.cg{font-family:'Zhi Mang Xing',cursive;font-size:56px;line-height:1;display:block;}\n.cg.u{color:var(--ember);text-shadow:var(--ge);}\n.cg.t{color:var(--jade);text-shadow:var(--gj);}\n.cn{font-family:'Ma Shan Zheng',cursive;font-size:10px;margin-top:2px;}\n.cn.u{color:rgba(168,64,48,0.8);}\n.cn.t{color:rgba(46,138,98,0.9);}\n.hbar{width:100%;max-width:200px;}\n.hlbl{font-family:'Ma Shan Zheng',cursive;font-size:9px;color:var(--t2);margin-bottom:2px;text-align:center;}\n.htrk{height:3px;background:var(--bd);border-radius:1px;overflow:hidden;}\n.hfll{height:100%;background:var(--ember);border-radius:1px;transition:width 0.6s;}\n.diff-wrap{width:100%;max-width:200px;}\n.dtitle{font-family:'Ma Shan Zheng',cursive;font-size:9px;color:var(--t2);margin-bottom:2px;text-align:center;}\n.drow{display:flex;align-items:center;gap:3px;padding:2px 5px;border-radius:1px;margin-bottom:2px;border:1px solid transparent;}\n.drow.bad{background:rgba(168,64,48,0.07);border-color:rgba(168,64,48,0.2);}\n.drow.ok{opacity:0.25;}\n.dl{font-family:'Ma Shan Zheng',cursive;font-size:8px;color:var(--t2);width:10px;}\n.dln{flex:1;height:3px;display:flex;}\n.dy{width:100%;height:3px;background:var(--laser-yang);border-radius:1px;box-shadow:0 0 5px var(--laser-yang);}\n.dn{width:100%;display:flex;gap:22%;height:3px;}\n.dnb{flex:1;height:3px;background:var(--laser-yin);border-radius:1px;box-shadow:0 0 4px var(--laser-yin);}\n.darr{color:var(--bd2);font-size:6px;}\n.dtag{font-family:'Space Mono',monospace;font-size:6px;color:var(--ember);border:1px solid rgba(168,64,48,0.25);padding:1px 2px;border-radius:1px;}\n.dgl{width:100%;max-width:240px;display:flex;flex-direction:column;gap:2px;}\n.dgi{display:flex;justify-content:space-between;align-items:center;padding:3px 6px;background:rgba(168,64,48,0.05);border:1px solid rgba(168,64,48,0.15);border-radius:1px;}\n.dgn{font-family:'Ma Shan Zheng',cursive;font-size:9px;color:var(--t1);}\n.dgv{font-family:'Space Mono',monospace;font-size:7px;font-weight:700;color:var(--ember);border:1px solid rgba(168,64,48,0.2);padding:1px 3px;border-radius:1px;background:rgba(0,0,0,0.4);}\n.eftr{position:fixed;bottom:0;left:0;width:100%;padding:10px;background:linear-gradient(to top,#000 60%,transparent);display:flex;justify-content:center;}\n.bcnt{font-family:'Ma Shan Zheng',cursive;font-size:14px;background:var(--t0);color:#000;border:none;cursor:pointer;padding:5px 16px;border-radius:1px;font-weight:700;transition:all 0.2s;}\n.bcnt:hover{background:#fff;}\n\n\/* VICTORY *\/\n#vov{position:fixed;inset:0;z-index:210;background:#000;display:flex;flex-direction:column;align-items:center;justify-content:center;opacity:0;transition:opacity 0.5s;}\n#vov.hidden{display:none;}\n#vov.on{opacity:1;}\n#vg{font-family:'Zhi Mang Xing',cursive;font-size:min(40vw,180px);line-height:1;color:var(--jade);text-shadow:0 0 40px rgba(46,138,98,0.8),0 0 80px rgba(46,138,98,0.3);opacity:0;transition:opacity 0.12s;}\n#vp{font-family:'Space Mono',monospace;font-size:9px;color:var(--t2);margin-top:8px;letter-spacing:0.3em;}\n.vlbl{font-family:'Ma Shan Zheng',cursive;font-size:14px;color:var(--jade);margin-bottom:14px;animation:blink 0.8s infinite;}\n<\/style>\n<\/head>\n<body>\n<div id=\"shell\">\n  <div id=\"matrix\">\n    <div id=\"center\">\n      <div id=\"ghost\"><\/div>\n      <div id=\"flash-target\"><\/div>\n      <div style=\"display:flex;flex-direction:column;align-items:center;gap:2px;width:100%;position:relative;z-index:2;\">\n        <div id=\"yao-display\"><\/div>\n        <div id=\"vnode\">· · ·<\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <div id=\"ctrl\">\n    <div id=\"ctrl-left\">\n      <div class=\"flip-row\">\n        <button class=\"fb\" onclick=\"totalFlip()\">☯<\/button>\n        <button class=\"fb\" onclick=\"flipUpperTri()\">⬆<\/button>\n        <button class=\"fb\" onclick=\"flipLowerTri()\">⬇<\/button>\n        <button class=\"fb\" onclick=\"invertHex()\">⇳<\/button>\n      <\/div>\n      <div class=\"flip-row\">\n        <button class=\"fb\" onclick=\"swapTrigrams()\">⇅<\/button>\n        <button class=\"fb\" onclick=\"flipUpperOuter()\">➡<\/button>\n        <button class=\"fb\" onclick=\"flipLowerOuter()\">⬅<\/button>\n        <button class=\"fb\" onclick=\"flipBothOuter()\">⇔<\/button>\n      <\/div>\n      <div class=\"flip-row\">\n        <button class=\"fb\" onclick=\"flipBothCore()\">⋈<\/button>\n      <\/div>\n    <\/div>\n\n    <div id=\"ctrl-mid\">\n      <div id=\"icon-row\">\n        <div id=\"hex-icon\" class=\"blank\" onclick=\"logoSpeak()\">？<\/div>\n        <div id=\"meta-col\">\n          <div id=\"hex-zh\">—<\/div>\n          <div id=\"hex-py\"><\/div>\n          <div id=\"hex-qi\"><\/div>\n          <div id=\"hex-tl\">— · —<\/div>\n          <div id=\"vnode-lbl\">虛節 ·<\/div>\n        <\/div>\n        <button class=\"speak-btn\" onclick=\"speakCurrent()\">⊹<\/button>\n      <\/div>\n      <div id=\"vf-row\">\n        <button id=\"voice-btn\" onclick=\"toggleVoice()\">🎤<\/button>\n        <div id=\"chat-txt\">待閃念...<\/div>\n        <button id=\"flash-btn\" onclick=\"handleFlash()\">☼<\/button>\n        <button id=\"reset-btn\" onclick=\"doReset()\">↺<\/button>\n      <\/div>\n    <\/div>\n\n    <div id=\"ctrl-right\">\n      <div class=\"ds\">\n        <button class=\"db on\" id=\"d3\" onclick=\"setDiff(3)\">三<\/button>\n        <button class=\"db\" id=\"d5\" onclick=\"setDiff(5)\">五<\/button>\n        <button class=\"db\" id=\"d8\" onclick=\"setDiff(8)\">八<\/button>\n      <\/div>\n      <div id=\"prog\"><\/div>\n      <div id=\"stt\">〇<\/div>\n      <div class=\"score-row\">\n        <div class=\"sc-item\"><div class=\"sc-v\" id=\"sv\">0<\/div><div class=\"sc-l\">連<\/div><\/div>\n        <div class=\"sc-item\"><div class=\"sc-v\" id=\"tv\">0<\/div><div class=\"sc-l\">節<\/div><\/div>\n      <\/div>\n      <div class=\"spd-trk\"><div class=\"spd-fill\" id=\"spd\" style=\"width:0%\"><\/div><\/div>\n      <div id=\"fb\">待...<\/div>\n    <\/div>\n  <\/div>\n<\/div>\n\n<div id=\"eov\" class=\"hidden\">\n  <div class=\"et\">失<\/div>\n  <div class=\"cmp-row\">\n    <div class=\"cbox\"><div class=\"clbl\">汝<\/div><span id=\"eu-g\" class=\"cg u\"><\/span><div id=\"eu-n\" class=\"cn u\"><\/div><\/div>\n    <div style=\"color:#1e1e1e;font-size:14px;\">→<\/div>\n    <div class=\"cbox\"><div class=\"clbl\">正<\/div><span id=\"et-g\" class=\"cg t\"><\/span><div id=\"et-n\" class=\"cn t\"><\/div><\/div>\n  <\/div>\n  <div class=\"hbar\"><div class=\"hlbl\">爻變<\/div><div class=\"htrk\"><div class=\"hfll\" id=\"hf\"><\/div><\/div><\/div>\n  <div class=\"diff-wrap\"><div class=\"dtitle\">錯爻<\/div><div id=\"dlist\"><\/div><\/div>\n  <div class=\"dgl\" id=\"diagl\"><\/div>\n  <div class=\"eftr\"><button class=\"bcnt\" onclick=\"closeErr()\">續<\/button><\/div>\n<\/div>\n\n<div id=\"vov\" class=\"hidden\">\n  <div class=\"vlbl\">合<\/div>\n  <div id=\"vg\"><\/div>\n  <div id=\"vp\"><\/div>\n<\/div>\n\n<script>\n\/\/ ─── DATA ─────────────────────────────────────────────────────\nconst TRI={\n  '000':{g:'☷',z:'坤',nat:'地'},\n  '100':{g:'☳',z:'震',nat:'雷'},\n  '010':{g:'☵',z:'坎',nat:'水'},\n  '110':{g:'☱',z:'兌',nat:'澤'},\n  '001':{g:'☶',z:'艮',nat:'山'},\n  '101':{g:'☲',z:'離',nat:'火'},\n  '011':{g:'☴',z:'巽',nat:'風'},\n  '111':{g:'☰',z:'乾',nat:'天'}\n};\n\/\/ Order: ☰☴☶☲☱☵☳☷\nconst TRI_ORDER=['111','011','001','101','110','010','100','000'];\n\n\/\/ Digrams: key = top_bit + bottom_bit (read visually top=lines[n+1], bottom=lines[n])\nconst DGR={\n  '11':{g:'⚌',z:'太陽'},\n  '10':{g:'⚍',z:'少陰'},\n  '01':{g:'⚎',z:'少陽'},\n  '00':{g:'⚏',z:'太陰'}\n};\nconst MONO={1:{g:'⚊',z:'陽'},0:{g:'⚋',z:'陰'}};\n\nconst HEXAGRAMS=[\n  {b:'111111',g:'䷀',z:'乾',p:'qián'},{b:'000000',g:'䷁',z:'坤',p:'kūn'},\n  {b:'100010',g:'䷂',z:'屯',p:'zhūn'},{b:'010001',g:'䷃',z:'蒙',p:'méng'},\n  {b:'111010',g:'䷄',z:'需',p:'xū'},{b:'010111',g:'䷅',z:'訟',p:'sòng'},\n  {b:'010000',g:'䷆',z:'師',p:'shī'},{b:'000010',g:'䷇',z:'比',p:'bǐ'},\n  {b:'111011',g:'䷈',z:'小畜',p:'xiǎo xù'},{b:'110111',g:'䷉',z:'履',p:'lǚ'},\n  {b:'111000',g:'䷊',z:'泰',p:'tài'},{b:'000111',g:'䷋',z:'否',p:'pǐ'},\n  {b:'101111',g:'䷌',z:'同人',p:'tóng rén'},{b:'111101',g:'䷍',z:'大有',p:'dà yǒu'},\n  {b:'001000',g:'䷎',z:'謙',p:'qiān'},{b:'000100',g:'䷏',z:'豫',p:'yù'},\n  {b:'100110',g:'䷐',z:'隨',p:'suí'},{b:'011001',g:'䷑',z:'蠱',p:'gǔ'},\n  {b:'110000',g:'䷒',z:'臨',p:'lín'},{b:'000011',g:'䷓',z:'觀',p:'guān'},\n  {b:'100101',g:'䷔',z:'噬嗑',p:'shì kè'},{b:'101001',g:'䷕',z:'賁',p:'bì'},\n  {b:'000001',g:'䷖',z:'剝',p:'bō'},{b:'100000',g:'䷗',z:'復',p:'fù'},\n  {b:'100111',g:'䷘',z:'無妄',p:'wú wàng'},{b:'111001',g:'䷙',z:'大畜',p:'dà xù'},\n  {b:'100001',g:'䷚',z:'頤',p:'yí'},{b:'011110',g:'䷛',z:'大過',p:'dà guò'},\n  {b:'010010',g:'䷜',z:'坎',p:'kǎn'},{b:'101101',g:'䷝',z:'離',p:'lí'},\n  {b:'001110',g:'䷞',z:'咸',p:'xián'},{b:'011100',g:'䷟',z:'恆',p:'héng'},\n  {b:'001111',g:'䷠',z:'遯',p:'dùn'},{b:'111100',g:'䷡',z:'大壯',p:'dà zhuàng'},\n  {b:'000101',g:'䷢',z:'晉',p:'jìn'},{b:'101000',g:'䷣',z:'明夷',p:'míng yí'},\n  {b:'101011',g:'䷤',z:'家人',p:'jiā rén'},{b:'110101',g:'䷥',z:'睽',p:'kuí'},\n  {b:'001010',g:'䷦',z:'蹇',p:'jiǎn'},{b:'010100',g:'䷧',z:'解',p:'jiě'},\n  {b:'110001',g:'䷨',z:'損',p:'sǔn'},{b:'100011',g:'䷩',z:'益',p:'yì'},\n  {b:'111110',g:'䷪',z:'夬',p:'guài'},{b:'011111',g:'䷫',z:'姤',p:'gòu'},\n  {b:'000110',g:'䷬',z:'萃',p:'cuì'},{b:'011000',g:'䷭',z:'升',p:'shēng'},\n  {b:'010110',g:'䷮',z:'困',p:'kùn'},{b:'011010',g:'䷯',z:'井',p:'jǐng'},\n  {b:'101110',g:'䷰',z:'革',p:'gé'},{b:'011101',g:'䷱',z:'鼎',p:'dǐng'},\n  {b:'100100',g:'䷲',z:'震',p:'zhèn'},{b:'001001',g:'䷳',z:'艮',p:'gèn'},\n  {b:'001011',g:'䷴',z:'漸',p:'jiàn'},{b:'110100',g:'䷵',z:'歸妹',p:'guī mèi'},\n  {b:'101100',g:'䷶',z:'豐',p:'fēng'},{b:'001101',g:'䷷',z:'旅',p:'lǚ'},\n  {b:'011011',g:'䷸',z:'巽',p:'xùn'},{b:'110110',g:'䷹',z:'兌',p:'duì'},\n  {b:'010011',g:'䷺',z:'渙',p:'huàn'},{b:'110010',g:'䷻',z:'節',p:'jié'},\n  {b:'110011',g:'䷼',z:'中孚',p:'zhōng fú'},{b:'001100',g:'䷽',z:'小過',p:'xiǎo guò'},\n  {b:'101010',g:'䷾',z:'既濟',p:'jì jì'},{b:'010101',g:'䷿',z:'未濟',p:'wèi jì'}\n];\nconst HM=Object.fromEntries(HEXAGRAMS.map(h=>[h.b,h]));\n\n\/\/ ─── STATE ─────────────────────────────────────────────────────\nlet lines=[null,null,null,null,null,null];\nlet isTraining=false,currentTarget=null;\nlet streak=0,totalN=0;\nlet seqLen=3,seq=[],seqIdx=0;\nconst MXDUR=1100,MNDUR=130;\n\n\/\/ ─── AUDIO ENGINE ──────────────────────────────────────────────\nconst AC=window.AudioContext||window.webkitAudioContext;\nconst ac=new AC();\n\nfunction noteHz(midi){return 440*Math.pow(2,(midi-69)\/12);}\n\n\/\/ Tone hierarchy: hex(4) > tri(3) > digram(2) > mono(1)\n\/\/ Returns midi note for dominant symbol level\nfunction getDominantTone(){\n  const allSet=!lines.some(v=>v===null);\n  if(allSet){\n    \/\/ Hexagram level: use midi(b) = 48 + (parseInt(b,2)%36)\n    const b=lines.join('');\n    return {midi:48+(parseInt(b,2)%36), level:4};\n  }\n  \/\/ Check if upper OR lower trigram set\n  const upperSet=lines.slice(3).every(v=>v!==null);\n  const lowerSet=lines.slice(0,3).every(v=>v!==null);\n  if(upperSet&&lowerSet){\n    \/\/ Both set but lines has nulls? shouldn't happen\n    return null;\n  }\n  if(upperSet){\n    const k=String(lines[5])+String(lines[4])+String(lines[3]);\n    const idx=TRI_ORDER.indexOf(k);\n    return {midi:60+idx, level:3, which:'upper', key:k};\n  }\n  if(lowerSet){\n    const k=String(lines[2])+String(lines[1])+String(lines[0]);\n    const idx=TRI_ORDER.indexOf(k);\n    return {midi:60+idx, level:3, which:'lower', key:k};\n  }\n  \/\/ Check digrams - upper first\n  \/\/ Upper digram top: lines[4]+lines[5]\n  \/\/ Upper digram bot: lines[3]+lines[4]\n  \/\/ Lower digram top: lines[1]+lines[2]\n  \/\/ Lower digram bot: lines[0]+lines[1]\n  \/\/ If core yao set for upper (line4)\n  if(lines[4]!==null&&lines[5]!==null){\n    const k=String(lines[4])+String(lines[5]);\n    const midi={11:66,10:67,01:68,00:69}[k]||67;\n    return {midi,level:2};\n  }\n  if(lines[4]!==null&&lines[3]!==null){\n    const k=String(lines[4])+String(lines[3]);\n    const midi={11:66,10:67,01:68,00:69}[k]||67;\n    return {midi,level:2};\n  }\n  if(lines[1]!==null&&lines[2]!==null){\n    const k=String(lines[1])+String(lines[2]);\n    const midi={11:54,10:55,01:56,00:57}[k]||55;\n    return {midi,level:2};\n  }\n  if(lines[1]!==null&&lines[0]!==null){\n    const k=String(lines[1])+String(lines[0]);\n    const midi={11:54,10:55,01:56,00:57}[k]||55;\n    return {midi,level:2};\n  }\n  \/\/ Single yao\n  for(let i=5;i>=0;i--){\n    if(lines[i]!==null){\n      \/\/ Yang=48, Yin=36\n      return {midi:lines[i]===1?48:36, level:1};\n    }\n  }\n  return null;\n}\n\nfunction tone(m,t='sine',d=0.35,vol=0.12){\n  if(ac.state==='suspended')ac.resume();\n  const f=noteHz(m);\n  const o=ac.createOscillator(),g=ac.createGain();\n  o.type=t;o.frequency.value=f;\n  g.gain.setValueAtTime(0.0001,ac.currentTime);\n  g.gain.exponentialRampToValueAtTime(vol,ac.currentTime+0.01);\n  g.gain.exponentialRampToValueAtTime(0.001,ac.currentTime+d);\n  o.connect(g);g.connect(ac.destination);\n  o.start();o.stop(ac.currentTime+d+0.05);\n}\n\n\/\/ Play dominant tone based on current state\nfunction playDominant(){\n  const dt=getDominantTone();\n  if(!dt)return;\n  \/\/ type and duration based on level\n  const types=['sine','sine','triangle','sine','sine'];\n  const durs=[0,0.25,0.3,0.4,0.5];\n  const vols=[0,0.08,0.09,0.1,0.12];\n  tone(dt.midi,types[dt.level],durs[dt.level],vols[dt.level]);\n}\n\n\/\/ Play trigram partial tone (when pressing trigram button — no hex)\nfunction playTriTone(k, which){\n  const idx=TRI_ORDER.indexOf(k);\n  tone(60+idx,'triangle',0.4,0.1);\n}\n\n\/\/ Play digram tone\nfunction playDiTone(bits){\n  const map={11:66,10:67,01:68,00:69};\n  tone(map[bits]||67,'sine',0.3,0.08);\n}\n\n\/\/ Play mono tone\nfunction playMonoTone(v){\n  tone(v===1?48:36,'sine',0.25,0.07);\n}\n\n\/\/ ─── TTS ───────────────────────────────────────────────────────\nfunction speak(txt){\n  if(!window.speechSynthesis)return;\n  const u=new SpeechSynthesisUtterance(txt);\n  u.lang='zh-TW';u.rate=0.82;\n  speechSynthesis.cancel();speechSynthesis.speak(u);\n}\nfunction speakCurrent(){\n  const allSet=!lines.some(v=>v===null);\n  if(!allSet)return;\n  const m=HM[lines.join('')];\n  if(m)speak(m.z+' '+m.p);\n}\nfunction logoSpeak(){speak('易經高');}\n\n\/\/ ─── UTIL ──────────────────────────────────────────────────────\nfunction setStt(c,t){const e=document.getElementById('stt');e.className=c;e.textContent=t;}\nfunction setFb(t,c){const e=document.getElementById('fb');e.textContent=t;if(c!==undefined)e.className=c;}\nfunction setChatTxt(t){document.getElementById('chat-txt').textContent=t;}\nfunction fieldSum(b){return b.split('').reduce((a,c)=>a+(c==='1'?.5:-.5),0)-1.0;}\nconst YL=['初','二','三','四','五','上'];\n\n\/\/ ─── DIFFICULTY ────────────────────────────────────────────────\nfunction setDiff(n){if(isTraining)return;seqLen=n;[3,5,8].forEach(x=>document.getElementById('d'+x).className='db'+(x===n?' on':''));renderProg();}\nfunction renderProg(){\n  const p=document.getElementById('prog');p.innerHTML='';\n  for(let i=0;i<seqLen;i++){const d=document.createElement('div');d.className='pn'+(i<seqIdx?' done':(i===seqIdx&&isTraining?' cur':''));p.appendChild(d);}\n}\nfunction updateScore(){\n  const sv=document.getElementById('sv'),tv=document.getElementById('tv');\n  sv.textContent=streak;tv.textContent=totalN;\n  sv.classList.remove('pop');void sv.offsetWidth;sv.classList.add('pop');\n  const pct=Math.min(100,(streak\/20)*100);\n  const sp=document.getElementById('spd');sp.style.width=pct+'%';\n  sp.style.background=pct>66?'var(--ember)':pct>33?'var(--yang)':'var(--jade)';\n}\n\n\/\/ ─── BUILD MATRIX ──────────────────────────────────────────────\nfunction makeHexTile(h){\n  const d=document.createElement('div');\n  d.className='T hx';d.dataset.b=h.b;d.textContent=h.g;d.title=h.z;\n  d.onclick=()=>{\n    for(let i=0;i<6;i++)lines[i]=parseInt(h.b[i]);\n    render();playDominant();\n  };\n  return d;\n}\nfunction makeTriTile(k,which){\n  const tr=TRI[k];\n  const d=document.createElement('div');\n  d.className='T tri-t';d.dataset.tri=k;d.dataset.which=which;\n  d.textContent=tr.g;d.title=tr.z;\n  d.onclick=()=>{\n    if(which==='upper'){lines[5]=parseInt(k[0]);lines[4]=parseInt(k[1]);lines[3]=parseInt(k[2]);}\n    else{lines[2]=parseInt(k[0]);lines[1]=parseInt(k[1]);lines[0]=parseInt(k[2]);}\n    render();playDominant();\n  };\n  return d;\n}\nfunction makeYaoTile(id,flipFn,initSymbol){\n  const d=document.createElement('div');\n  d.className='T yao-t';d.id=id;d.textContent=initSymbol||'⚏';\n  d.onclick=()=>{flipFn();playDominant();};\n  return d;\n}\n\nfunction place(el,col,row,m){\n  el.style.gridColumn=String(col);el.style.gridRow=String(row);\n  m.appendChild(el);\n}\n\nfunction buildMatrix(){\n  const m=document.getElementById('matrix');\n  const center=document.getElementById('center');\n  center.style.gridColumn='3\/11';center.style.gridRow='4\/10';\n\n  \/\/ Row 1: hex 0..11\n  for(let c=0;c<12;c++) place(makeHexTile(HEXAGRAMS[c]),c+1,1,m);\n\n  \/\/ Row 2: hex 12-13 | 8 upper trigrams | hex 44-45\n  place(makeHexTile(HEXAGRAMS[12]),1,2,m);\n  place(makeHexTile(HEXAGRAMS[13]),2,2,m);\n  TRI_ORDER.forEach((k,i)=>place(makeTriTile(k,'upper'),3+i,2,m));\n  place(makeHexTile(HEXAGRAMS[44]),11,2,m);\n  place(makeHexTile(HEXAGRAMS[45]),12,2,m);\n\n  \/\/ Row 3: hex 14-15 | upper yao\/digram | hex 46-47\n  place(makeHexTile(HEXAGRAMS[14]),1,3,m);\n  place(makeHexTile(HEXAGRAMS[15]),2,3,m);\n  \/\/ Upper yao row: 8 slots cols 3-10\n  \/\/ Left 4: outer-top(line5), core(line4), core-mirror(line4), outer-bot(line3)\n  \/\/ Right 4: mirror\n  place(makeYaoTile('ur0',()=>flipLine(5)),3,3,m);\n  place(makeYaoTile('ur1',()=>flipLine(4)),4,3,m);\n  place(makeYaoTile('ur2',()=>flipLine(4)),5,3,m);\n  place(makeYaoTile('ur3',()=>flipLine(3)),6,3,m);\n  place(makeYaoTile('ur4',()=>flipLine(3)),7,3,m);\n  place(makeYaoTile('ur5',()=>flipLine(4)),8,3,m);\n  place(makeYaoTile('ur6',()=>flipLine(4)),9,3,m);\n  place(makeYaoTile('ur7',()=>flipLine(5)),10,3,m);\n  place(makeHexTile(HEXAGRAMS[46]),11,3,m);\n  place(makeHexTile(HEXAGRAMS[47]),12,3,m);\n\n  \/\/ Rows 4-9 side columns\n  const lHex=[16,18,20,22,24,26];\n  const rHex=[48,50,52,54,56,58];\n  for(let r=0;r<6;r++){\n    const row=4+r;\n    place(makeHexTile(HEXAGRAMS[lHex[r]]),1,row,m);\n    place(makeHexTile(HEXAGRAMS[lHex[r]+1]),2,row,m);\n    place(makeHexTile(HEXAGRAMS[rHex[r]]),11,row,m);\n    place(makeHexTile(HEXAGRAMS[rHex[r]+1]),12,row,m);\n  }\n\n  \/\/ Row 10: lower yao\/digram\n  place(makeHexTile(HEXAGRAMS[28]),1,10,m);\n  place(makeHexTile(HEXAGRAMS[29]),2,10,m);\n  place(makeYaoTile('lr0',()=>flipLine(2)),3,10,m);\n  place(makeYaoTile('lr1',()=>flipLine(1)),4,10,m);\n  place(makeYaoTile('lr2',()=>flipLine(1)),5,10,m);\n  place(makeYaoTile('lr3',()=>flipLine(0)),6,10,m);\n  place(makeYaoTile('lr4',()=>flipLine(0)),7,10,m);\n  place(makeYaoTile('lr5',()=>flipLine(1)),8,10,m);\n  place(makeYaoTile('lr6',()=>flipLine(1)),9,10,m);\n  place(makeYaoTile('lr7',()=>flipLine(2)),10,10,m);\n  place(makeHexTile(HEXAGRAMS[60]),11,10,m);\n  place(makeHexTile(HEXAGRAMS[61]),12,10,m);\n\n  \/\/ Row 11: lower trigrams\n  place(makeHexTile(HEXAGRAMS[30]),1,11,m);\n  place(makeHexTile(HEXAGRAMS[31]),2,11,m);\n  TRI_ORDER.forEach((k,i)=>place(makeTriTile(k,'lower'),3+i,11,m));\n  place(makeHexTile(HEXAGRAMS[62]),11,11,m);\n  place(makeHexTile(HEXAGRAMS[63]),12,11,m);\n\n  \/\/ Row 12: bottom hex\n  for(let c=0;c<12;c++) place(makeHexTile(HEXAGRAMS[32+c]),c+1,12,m);\n}\n\n\/\/ ─── UPDATE AUX BUTTONS ────────────────────────────────────────\nfunction updateAuxBtns(){\n  const blank=lines.some(v=>v===null);\n  const g=id=>document.getElementById(id);\n\n  if(blank){\n    ['ur0','ur1','ur2','ur3','ur4','ur5','ur6','ur7',\n     'lr0','lr1','lr2','lr3','lr4','lr5','lr6','lr7'].forEach(id=>{\n      const e=g(id);if(e){e.textContent='⚏';e.className='T yao-t';}\n    });\n    return;\n  }\n\n  \/\/ Upper row symbols\n  \/\/ ur0\/ur7: digram of lines[4]+lines[5] (outer top of upper tri)\n  const d45=DGR[String(lines[4])+String(lines[5])]||{g:'⚏'};\n  \/\/ ur1\/ur2\/ur5\/ur6: monogram of lines[4] (core of upper tri)\n  const m4=MONO[lines[4]]||{g:'⚋'};\n  \/\/ ur3\/ur4: digram of lines[3]+lines[4] (outer bottom of upper tri)\n  const d34=DGR[String(lines[3])+String(lines[4])]||{g:'⚏'};\n\n  if(g('ur0'))g('ur0').textContent=d45.g;\n  if(g('ur1'))g('ur1').textContent=m4.g;\n  if(g('ur2'))g('ur2').textContent=m4.g;\n  if(g('ur3'))g('ur3').textContent=d34.g;\n  if(g('ur4'))g('ur4').textContent=d34.g;\n  if(g('ur5'))g('ur5').textContent=m4.g;\n  if(g('ur6'))g('ur6').textContent=m4.g;\n  if(g('ur7'))g('ur7').textContent=d45.g;\n\n  \/\/ Lower row symbols\n  const d12=DGR[String(lines[1])+String(lines[2])]||{g:'⚏'};\n  const m1=MONO[lines[1]]||{g:'⚋'};\n  const d01=DGR[String(lines[0])+String(lines[1])]||{g:'⚏'};\n\n  if(g('lr0'))g('lr0').textContent=d12.g;\n  if(g('lr1'))g('lr1').textContent=m1.g;\n  if(g('lr2'))g('lr2').textContent=m1.g;\n  if(g('lr3'))g('lr3').textContent=d01.g;\n  if(g('lr4'))g('lr4').textContent=d01.g;\n  if(g('lr5'))g('lr5').textContent=m1.g;\n  if(g('lr6'))g('lr6').textContent=m1.g;\n  if(g('lr7'))g('lr7').textContent=d12.g;\n\n  \/\/ Highlights — yang = on class, yin = on-yin class\n  const setYaoClass=(id,v)=>{\n    const e=g(id);if(!e)return;\n    e.className='T yao-t'+(v===1?' on':v===0?' on-yin':'');\n  };\n  \/\/ Upper outer: on if yang\n  setYaoClass('ur0',lines[4]===1&&lines[5]===1?1:lines[4]===0&&lines[5]===0?0:null);\n  setYaoClass('ur7',lines[4]===1&&lines[5]===1?1:lines[4]===0&&lines[5]===0?0:null);\n  setYaoClass('ur1',lines[4]);setYaoClass('ur2',lines[4]);setYaoClass('ur5',lines[4]);setYaoClass('ur6',lines[4]);\n  setYaoClass('ur3',lines[3]===1&&lines[4]===1?1:lines[3]===0&&lines[4]===0?0:null);\n  setYaoClass('ur4',lines[3]===1&&lines[4]===1?1:lines[3]===0&&lines[4]===0?0:null);\n\n  setYaoClass('lr0',lines[1]===1&&lines[2]===1?1:lines[1]===0&&lines[2]===0?0:null);\n  setYaoClass('lr7',lines[1]===1&&lines[2]===1?1:lines[1]===0&&lines[2]===0?0:null);\n  setYaoClass('lr1',lines[1]);setYaoClass('lr2',lines[1]);setYaoClass('lr5',lines[1]);setYaoClass('lr6',lines[1]);\n  setYaoClass('lr3',lines[0]===1&&lines[1]===1?1:lines[0]===0&&lines[1]===0?0:null);\n  setYaoClass('lr4',lines[0]===1&&lines[1]===1?1:lines[0]===0&&lines[1]===0?0:null);\n}\n\nfunction highlightGrid(){\n  if(lines.some(v=>v===null)){document.querySelectorAll('.hx').forEach(e=>e.classList.remove('ahx'));return;}\n  const b=lines.join('');\n  document.querySelectorAll('.hx').forEach(e=>e.classList.toggle('ahx',e.dataset.b===b));\n}\nfunction highlightTri(){\n  if(lines.some(v=>v===null)){document.querySelectorAll('.tri-t').forEach(e=>e.classList.remove('atb'));return;}\n  const uk=String(lines[5])+String(lines[4])+String(lines[3]);\n  const lk=String(lines[2])+String(lines[1])+String(lines[0]);\n  document.querySelectorAll('.tri-t[data-which=\"upper\"]').forEach(e=>e.classList.toggle('atb',e.dataset.tri===uk));\n  document.querySelectorAll('.tri-t[data-which=\"lower\"]').forEach(e=>e.classList.toggle('atb',e.dataset.tri===lk));\n}\n\n\/\/ ─── RENDER YAO ────────────────────────────────────────────────\nfunction renderYao(){\n  const d=document.getElementById('yao-display');d.innerHTML='';\n  for(let i=5;i>=0;i--){\n    const val=lines[i];\n    const div=document.createElement('div');div.className='yl';\n    div.onclick=()=>{flipLine(i);};\n    if(val===null) div.innerHTML='<div class=\"yl-blank\"><\/div>';\n    else if(val===1) div.innerHTML='<div class=\"yl-yang\"><\/div>';\n    else div.innerHTML='<div class=\"yl-yin\"><div class=\"yl-yin-b\"><\/div><div class=\"yl-yin-b\"><\/div><\/div>';\n    d.appendChild(div);\n    if(i===3){const g=document.createElement('div');g.className='yl-gap';d.appendChild(g);}\n  }\n}\n\n\/\/ ─── MAIN RENDER ───────────────────────────────────────────────\nfunction render(){\n  renderYao();\n  const allSet=!lines.some(v=>v===null);\n  const b=allSet?lines.join(''):null;\n  const match=b?HM[b]:null;\n\n  \/\/ Ghost & flash\n  const gh=document.getElementById('ghost');\n  gh.textContent=match?match.g:(allSet?'？':'');\n  gh.classList.toggle('vivid',!!match);\n\n  \/\/ Icon\n  const hi=document.getElementById('hex-icon');\n  if(!allSet){hi.textContent='？';hi.className='blank';}\n  else{hi.textContent=match?match.g:'？';hi.className=match?'matched':'';}\n\n  \/\/ Meta\n  document.getElementById('hex-zh').textContent=match?match.z:'—';\n  document.getElementById('hex-py').textContent=match?match.p:'';\n  const qi=document.getElementById('hex-qi');\n  if(allSet){const t=fieldSum(b);qi.textContent=(t>=0?'+':'')+t.toFixed(1);qi.className=t>=0?'pos':'neg';}\n  else{qi.textContent='';qi.className='';}\n  if(allSet){\n    const uk=String(lines[5])+String(lines[4])+String(lines[3]);\n    const lk=String(lines[2])+String(lines[1])+String(lines[0]);\n    const ut=TRI[uk],lt=TRI[lk];\n    document.getElementById('hex-tl').textContent=`${ut?ut.g+ut.z:'—'} · ${lt?lt.g+lt.z:'—'}`;\n  } else document.getElementById('hex-tl').textContent='— · —';\n\n  \/\/ Virtual node — the two center yao (line 1 and line 4)\n  const vnEl=document.getElementById('vnode');\n  const vnLbl=document.getElementById('vnode-lbl');\n  if(lines[1]!==null&&lines[4]!==null){\n    const vnSym=(lines[4]===1?'⚊':'⚋')+' ⊕ '+(lines[1]===1?'⚊':'⚋');\n    vnEl.textContent=vnSym;\n    vnEl.className='active';\n    vnLbl.textContent='虛節 '+DGR[String(lines[4])+String(lines[1])]?.z||'虛節';\n    vnLbl.classList.add('active');\n  } else {\n    vnEl.textContent='· · ·';\n    vnEl.className='';\n    vnLbl.textContent='虛節 ·';\n    vnLbl.classList.remove('active');\n  }\n\n  highlightGrid();highlightTri();updateAuxBtns();\n  if(isTraining)setStt('si','一');\n}\n\n\/\/ ─── LINE FLIPS ────────────────────────────────────────────────\nfunction flipLine(i){\n  if(lines[i]===null)lines[i]=0;else lines[i]^=1;\n  render();playDominant();\n}\nfunction totalFlip(){\n  if(lines.some(v=>v===null))lines=[1,1,1,1,1,1];\n  else for(let i=0;i<6;i++)lines[i]^=1;\n  render();playDominant();\n}\nfunction flipUpperTri(){[3,4,5].forEach(i=>{if(lines[i]===null)lines[i]=1;else lines[i]^=1;});render();playDominant();}\nfunction flipLowerTri(){[0,1,2].forEach(i=>{if(lines[i]===null)lines[i]=1;else lines[i]^=1;});render();playDominant();}\nfunction swapTrigrams(){\n  if(lines.some(v=>v===null))return;\n  const t=[lines[0],lines[1],lines[2]];\n  lines[0]=lines[3];lines[1]=lines[4];lines[2]=lines[5];\n  lines[3]=t[0];lines[4]=t[1];lines[5]=t[2];\n  render();playDominant();\n}\nfunction flipUpperOuter(){[3,5].forEach(i=>{if(lines[i]===null)lines[i]=1;else lines[i]^=1;});render();playDominant();}\nfunction flipLowerOuter(){[0,2].forEach(i=>{if(lines[i]===null)lines[i]=1;else lines[i]^=1;});render();playDominant();}\nfunction flipBothOuter(){[0,2,3,5].forEach(i=>{if(lines[i]===null)lines[i]=1;else lines[i]^=1;});render();playDominant();}\nfunction flipBothCore(){[1,4].forEach(i=>{if(lines[i]===null)lines[i]=1;else lines[i]^=1;});render();playDominant();}\nfunction invertHex(){if(lines.some(v=>v===null))return;for(let i=0;i<6;i++)lines[i]^=1;render();playDominant();}\n\n\/\/ ─── FLASH ─────────────────────────────────────────────────────\nfunction handleFlash(){\n  if(isTraining){doConfirm();return;}\n  if(seqIdx>=seqLen&&seqLen>0){doCascade();return;}\n  if(seq.length===0||seqIdx>=seqLen)genSeq();\n  doFlash(seq[seqIdx]);\n}\nfunction genSeq(){seq=[];for(let i=0;i<seqLen;i++)seq.push(HEXAGRAMS[Math.floor(Math.random()*64)]);seqIdx=0;renderProg();}\n\nfunction doFlash(tgt){\n  currentTarget=tgt;setStt('sf','閃');\n  const dur=Math.max(MNDUR,MXDUR-streak*55)+Math.floor(Math.random()*80);\n  lines=[null,null,null,null,null,null];render();\n  const ft=document.getElementById('flash-target');\n  ft.style.transform=`translate(${(Math.random()*10-5).toFixed(1)}%,${(Math.random()*8-4).toFixed(1)}%)`;\n  ft.textContent=tgt.g;ft.classList.add('show');\n  tone(48+(parseInt(tgt.b,2)%36),'sine',0.5,0.12);\n  setTimeout(()=>{\n    ft.classList.remove('show');ft.style.transform='none';\n    isTraining=true;lines=[null,null,null,null,null,null];render();renderProg();\n    document.getElementById('flash-btn').textContent='合';\n    document.getElementById('flash-btn').className='confirm';\n    setStt('si','一');setFb(`結 ${seqIdx+1}\/${seqLen}`,'act');\n    setChatTxt(`節 ${seqIdx+1}\/${seqLen}...`);\n  },dur);\n}\n\nfunction doConfirm(){\n  if(!isTraining)return;\n  if(lines.some(v=>v===null)){setFb('未完','act');return;}\n  const input=lines.join('');\n  if(input===currentTarget.b){\n    streak++;totalN++;isTraining=false;seqIdx++;\n    updateScore();renderProg();tone(72,'sine',0.5,0.12);\n    document.getElementById('flash-btn').textContent='☼';\n    document.getElementById('flash-btn').className='';\n    document.getElementById('hex-icon').classList.add('matched');\n    setStt('sm','合');\n    \/\/ no speech — just tone\n    if(seqIdx>=seqLen){setFb('道合','ok');setChatTxt('合');}\n    else{setFb(`合 · 連${streak}`,'ok');setChatTxt('次');}\n  } else {\n    streak=0;isTraining=false;updateScore();tone(36,'square',0.3,0.1);\n    document.getElementById('flash-btn').textContent='☼';\n    document.getElementById('flash-btn').className='';\n    setStt('se','失');showErr(input);\n  }\n}\n\n\/\/ ─── ERROR ─────────────────────────────────────────────────────\nfunction showErr(inp){\n  const um=HM[inp];\n  document.getElementById('eu-g').textContent=um?um.g:'？';\n  document.getElementById('eu-n').textContent=um?`${um.z} ${um.p}`:'未知';\n  document.getElementById('et-g').textContent=currentTarget.g;\n  document.getElementById('et-n').textContent=`${currentTarget.z} ${currentTarget.p}`;\n  let h=0;for(let i=0;i<6;i++)if(inp[i]!==currentTarget.b[i])h++;\n  document.getElementById('hf').style.width=((h\/6)*100)+'%';\n  const dl=document.getElementById('dlist');dl.innerHTML='';\n  for(let i=5;i>=0;i--){\n    const bad=inp[i]!==currentTarget.b[i],yr=inp[i]==='1',cr=currentTarget.b[i]==='1';\n    const r=document.createElement('div');r.className='drow '+(bad?'bad':'ok');\n    r.innerHTML=`<div class=\"dl\">${YL[i]}<\/div>\n      <div class=\"dln\">${yr?'<div class=\"dy\"><\/div>':'<div class=\"dn\"><div class=\"dnb\"><\/div><div class=\"dnb\"><\/div><\/div>'}<\/div>\n      <div class=\"darr\">→<\/div>\n      <div class=\"dln\">${cr?'<div class=\"dy\"><\/div>':'<div class=\"dn\"><div class=\"dnb\"><\/div><div class=\"dnb\"><\/div><\/div>'}<\/div>\n      ${bad?'<div class=\"dtag\">失<\/div>':''}`;\n    dl.appendChild(r);\n  }\n  const faults=diagFaults(currentTarget.b,inp);\n  document.getElementById('diagl').innerHTML=faults.map(f=>`<div class=\"dgi\"><span class=\"dgn\">${f.n}<\/span><span class=\"dgv\">${f.v}<\/span><\/div>`).join('');\n  document.getElementById('eov').classList.remove('hidden');\n}\nfunction diagFaults(e,a){\n  const f=[];\n  if(e[1]!==a[1])f.push({n:'內卦儀失·連動',v:'-1.0'});\n  else{if(e[0]!==a[0])f.push({n:'內卦初失',v:'-0.5'});if(e[2]!==a[2])f.push({n:'內卦三失',v:'-0.5'});}\n  if(e[4]!==a[4])f.push({n:'外卦儀失·連動',v:'-1.0'});\n  else{if(e[3]!==a[3])f.push({n:'外卦四失',v:'-0.5'});if(e[5]!==a[5])f.push({n:'外卦上失',v:'-0.5'});}\n  if(e[2]!==a[2]||e[3]!==a[3])f.push({n:'卦交失·虛節崩',v:'-1.0'});\n  return f;\n}\nfunction closeErr(){document.getElementById('eov').classList.add('hidden');doReset();}\n\n\/\/ ─── RESET ─────────────────────────────────────────────────────\nfunction doReset(){\n  tone(30,'sawtooth',0.4,0.09);\n  lines=[null,null,null,null,null,null];\n  isTraining=false;currentTarget=null;seq=[];seqIdx=0;\n  renderProg();render();\n  document.getElementById('flash-target').textContent='';\n  document.getElementById('flash-target').classList.remove('show');\n  document.getElementById('flash-btn').textContent='☼';\n  document.getElementById('flash-btn').className='';\n  setStt('','〇');setFb('待...','');setChatTxt('待閃念...');\n}\n\n\/\/ ─── CASCADE — tones only, no speech ───────────────────────────\nfunction doCascade(){\n  setStt('sc','合');\n  const ov=document.getElementById('vov'),vg=document.getElementById('vg'),vp=document.getElementById('vp');\n  ov.classList.remove('hidden');setTimeout(()=>ov.classList.add('on'),30);\n  let idx=0;\n  const lp=setInterval(()=>{\n    if(idx>=seq.length){\n      clearInterval(lp);\n      setTimeout(()=>{ov.classList.remove('on');setTimeout(()=>{ov.classList.add('hidden');doReset();},500);},900);\n      return;\n    }\n    const nd=seq[idx];\n    vg.style.opacity='0';\n    setTimeout(()=>{vg.textContent=nd.g;vp.textContent=nd.p;vg.style.opacity='1';},80);\n    \/\/ TONES ONLY — no speak()\n    tone(48+(parseInt(nd.b,2)%36),'sine',0.6,0.12);\n    idx++;\n  },700);\n}\n\n\/\/ ─── VOICE ─────────────────────────────────────────────────────\nlet recog=null,listening=false;\nfunction toggleVoice(){\n  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;\n  if(!SR){setChatTxt('聲音不支持');return;}\n  if(listening){recog.stop();return;}\n  recog=new SR();recog.lang='zh-TW';recog.interimResults=false;recog.continuous=false;\n  recog.onstart=()=>{listening=true;document.getElementById('voice-btn').classList.add('on');setChatTxt('聽...');};\n  recog.onend=()=>{listening=false;document.getElementById('voice-btn').classList.remove('on');};\n  recog.onresult=e=>{\n    const t=e.results[0][0].transcript.trim();\n    setChatTxt(t);\n    const found=HEXAGRAMS.find(h=>t.includes(h.z)||t.toLowerCase().replace(\/\\s\/g,'').includes(h.p.replace(\/\\s\/g,'')));\n    if(found){for(let i=0;i<6;i++)lines[i]=parseInt(found.b[i]);render();playDominant();}\n  };\n  recog.start();\n}\n\n\/\/ ─── KEYBOARD ──────────────────────────────────────────────────\ndocument.addEventListener('keydown',e=>{\n  if(e.target.tagName==='INPUT')return;\n  if(e.code==='Space'){\n    e.preventDefault();\n    if(!document.getElementById('vov').classList.contains('hidden'))return;\n    if(!document.getElementById('eov').classList.contains('hidden')){closeErr();return;}\n    handleFlash();\n  }\n  if(e.code==='Enter'){e.preventDefault();if(isTraining)doConfirm();}\n  if(e.key==='r'||e.key==='R')doReset();\n  if(e.key==='f'||e.key==='F')totalFlip();\n  if(isTraining&&e.key>='1'&&e.key<='6')flipLine(parseInt(e.key)-1);\n});\n\n\/\/ ─── INIT ──────────────────────────────────────────────────────\nwindow.onload=()=>{\n  buildMatrix();\n  render();renderProg();setStt('','〇');\n};\n<\/script>\n<\/body>\n<\/html>\n",
