        const r = document.createElement('div');
        r.className = 'ep-row ' + (bad ? 'bad' : 'ok');
        r.innerHTML = `<div class="ep-ln">${n.i === Y ? '<div class="ep-dy"></div>' : '<div class="ep-dn"><div class="ep-dnb"></div><div class="ep-dnb"></div></div>'}</div><div class="ep-ln">${n.o === Y ? '<div class="ep-dy"></div>' : '<div class="ep-dn"><div class="ep-dnb"></div><div class="ep-dnb"></div></div>'}</div>`;
        c.appendChild(r);
    });
}

function doSubmit() {
    if (!isTraining || voidCount() > 0) return;
    const inp = getResolvedSig(); isTraining = false; seqldx++;
    const ft = document.getElementById('flash-target');
    ft.textContent = activeTarget.g; ft.classList.add('show');
    setTimeout(() => ft.classList.remove('show'), 300);
    sndHex(activeTarget);
    
    if (inp === activeTarget) {
        streak++; totalN++;
        document.getElementById('sv').textContent = streak;
        document.getElementById('tv').textContent = totalN;
        sndOK(); state = 'result-ok'; applyProj(activeTarget);
        
        const yd = document.getElementById('yao-display'); yd.classList.remove('glow');
        const md = document.getElementById('mini-display'); md.classList.remove('glow');
        void yd.offsetWidth; void md.offsetWidth;
        renderYao(); updateMini();
        yd.classList.add('glow'); md.classList.add('glow');
        
        updateRight(activeTarget); document.getElementById('panel-right').classList.add('show');
    } else {
        const ink = document.getElementById('ink-cloud');
        ink.classList.add('show'); void ink.offsetWidth; ink.classList.remove('show');
        missed.push(activeTarget); document.getElementById('tv').textContent = totalN;
        sndFail(); state = 'result-err'; showErr(inp); render();
    }
    updateFlashBtn();
}

function handleFlash() {
    if (state === 'cascade' || state === 'flashing') return;
    switch (state) {
        case 'idle': doFlash(); break;
        case 'building': doSubmit(); break;
        case 'result-ok': case 'result-err': clearCont(); break;
    }
}

function clearCont() {
    toggleOff(true);
    document.getElementById('flash-target').classList.remove('show');
    document.getElementById('yao-display').classList.remove('glow');
    document.getElementById('mini-display').classList.remove('glow');
    hideSP(); state = 'idle'; render();
    
    if (seqldx >= seqLen) {
        if (inRem) {
            inRem = false; seq = [];
        } else if (missed.length > 0) {
            seq = [...missed]; missed = []; seqldx = 0; seqLen = seq.length;
            inRem = true; streak = 0;
            document.getElementById('sv').textContent = streak;
            setTimeout(doFlash, 150); return;
        } else {
            modeldx++; const mA = MS[mode];
            if (modeldx >= mA.length) { startCascade(); return; }
            seqLen = mA[modeldx]; seqldx = 0; seq = [];
        }
    }
    setTimeout(doFlash, 150);
}

function startCascade() {
    state = 'cascade'; updateFlashBtn(); hideSP();
    document.getElementById('yao-display').classList.remove('glow');
    document.getElementById('mini-display').classList.remove('glow');
    cascadeQ = [...SIGS].sort(() => Math.random() - .5);
    cascadeldx = 0; playCasc();
}

function playCasc() {
    const ft = document.getElementById('flash-target');
    if (cascadeldx >= cascadeQ.length) {
        sndApex();
        cascadeTimer = setTimeout(() => { ft.classList.remove('show'); advTier(); }, 1600);
        return;
    }
    const sig = cascadeQ[cascadeldx];
    ft.textContent = sig.g; ft.classList.add('show'); sndHex(sig);
    cascadeldx++;
    cascadeTimer = setTimeout(() => {
        ft.classList.remove('show'); setTimeout(playCasc, 800);
    }, 900);
}

function advTier() {
    modeldx++;
    if (modeldx >= MS[mode].length) {
        if (mode === 'B') setMode('I');
        else if (mode === 'I') setMode('M');
        else { state = 'idle'; render(); return; }
        return;
    }
    seqLen = MS[mode][modeldx]; state = 'idle'; doReset(true);
}

function doReset(silent) {
    if(!silent) sndReset();
    if (cascadeTimer) { clearTimeout(cascadeTimer); cascadeTimer = null; }
    isTraining = false; activeTarget = null; seq = []; seqldx = 0; state = 'idle';
    cascadeQ = []; cascadeldx = 0;
    document.getElementById('flash-target').classList.remove('show');
    document.getElementById('yao-display').classList.remove('glow');
    document.getElementById('mini-display').classList.remove('glow');
    hideSP(); toggleOff(true);
}

function doRestart() {
    sndRestart(); streak = 0; totalN = 0; missed = []; inRem = false;
    document.getElementById('sv').textContent = 0; document.getElementById('tv').textContent = 0;
    doReset(true); setMode(mode);
}

function setMode(m) {
    if (state === 'building') return;
    mode = m; modeldx = 0; seqLen = MS[m][0]; seq = []; seqldx = 0; missed = []; inRem = false;
    ['B', 'I', 'M'].forEach(x => document.getElementById('d' + x).className = 'db' + (x === m ? ' on' : ''));
}

function toggleTheme() {
    const rt = document.documentElement;
    rt.dataset.theme = rt.dataset.theme === 'light' ? 'dark' : 'light';
    document.getElementById('theme-btn').textContent = rt.dataset.theme === 'light' ? '☽' : '☀';
}

document.addEventListener('keydown', e => {
    if (e.code === 'Space') { e.preventDefault(); handleFlash(); }
    if (e.key === 'r') doReset(false);
    if (e.key === '4') invertHex();
    if (e.key === '8') flipTopBottom();
    if (e.key === 'f') totalFlip();
});

window.addEventListener('resize', sizeDisplay);
window.onload = () => { buildGrid(); setTimeout(() => { sizeDisplay(); render(); }, 80); };
</script>
</body>
