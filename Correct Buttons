    osc.connect(gain); gain.connect(a.destination); osc.start(t); osc.stop(t + 1.6);
}

// --- RENDER ENGINE ---
function dTopo(states) {
    const h = states.length === 3 ? 3 : 4, gap = states.length === 3 ? 3 : (states.length === 2 ? 4 : 0);
    const tH = states.length * h + (states.length - 1) * gap, sY = (24 - tH) / 2;
    let s = `<svg viewBox="0 0 24 24" width="1.5em" height="1.5em" style="fill:currentColor; display:block; margin:auto;">`;
    states.forEach((st, i) => {
        if (st === V) return;
        const y = sY + i * (h + gap);
        if (st === Y) {
            s += `<rect x="2" y="${y}" width="20" height="${h}" rx=".5"/>`;
        } else {
            s += `<rect x="2" y="${y}" width="8" height="${h}" rx=".5"/><rect x="14" y="${y}" width="8" height="${h}" rx=".5"/>`;
        }
    });
    return s + '</svg>';
}

function dN(s) { return s === V ? '' : dTopo([s]); }
function dL(a, b) { return (a === V || b === V) ? '' : dTopo([a, b]); }
function dT(t) { return dTopo([t.d, t.k, t.p]); }

