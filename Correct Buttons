    if (p === Y) el.classList.add('on');
    else if (p === N) el.classList.add('on-yin');
}

function mkHex(pi) {
    if (pi >= PAIRS.length) { const d = document.createElement('div'); d.className = 'gb'; return d; }
    const [sa, sb] = PAIRS[pi]; const ss = get4(sa, sb);
    if (btnState[pi] === undefined) btnState[pi] = 0;
    btnState[pi] = btnState[pi] % ss.length;
    const b = document.createElement('button');
    b.className = 'gb hz'; b.textContent = ss[btnState[pi]].g;
    b.title = sa.z + '.' + sb.z; b.dataset.pi = pi;
    b.onclick = () => {
        let act = ss[btnState[pi]]; const curN = linesToN();
        if (curN !== null && curN === sigToN(act)) {
            btnState[pi] = (btnState[pi] + 1) % ss.length;
            act = ss[btnState[pi]]; b.textContent = act.g;
        }
        const an = sigToN(act); const loadSeq = [4, 1, 5, 2, 3, 0]; const lines = getLines();
        for (let i = 0; i < loadSeq.length; i++) {
            const idx = loadSeq[i];
            const tgt = Math.floor(an / Math.pow(2, 5 - idx)) % 2;
            if (lines[idx] !== tgt) {
                const { r, n } = LM[idx]; Proj[r][n] = tgt === 1 ? Y : N;
                render(); break;
            }
        }
    };
    refreshHL();
    return b;
}

function refreshHL() {
    const curN = linesToN();
    document.querySelectorAll('.gb.hz[data-pi]').forEach(b => {
        const pi = parseInt(b.dataset.pi);
        if (isNaN(pi) || pi >= PAIRS.length) return;
