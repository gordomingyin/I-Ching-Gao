}

// --- DETERMINISTIC ARRAY-STATE AUDIO ENGINE (729 States) ---
let ac = null;
let prevFreq = 216; 
let actOsc = null, actGain = null, actFilt = null, actVib = null, actTremGain = null;
window._lastVis = ''; 

function gAC() {
    if (!ac) ac = new (window.AudioContext || window.webkitAudioContext)();
    if (ac.state === 'suspended') ac.resume();
    return ac;
}

function hz(m) { return 432 * Math.pow(2, (m - 69) / 12); }

function stopCurrentSound() {
    if (actOsc) { try { actOsc.stop(); actOsc.disconnect(); } catch(e){} actOsc = null; }
    if (actGain) { try { actGain.disconnect(); } catch(e){} actGain = null; }
    if (actFilt) { try { actFilt.disconnect(); } catch(e){} actFilt = null; }
    if (actVib) { try { actVib.stop(); actVib.disconnect(); } catch(e){} actVib = null; }
    if (actTremGain) { try { actTremGain.disconnect(); } catch(e){} actTremGain = null; }
}

// Generates the unique mathematical fingerprint of any Yao/Si Xiang configuration
function getPanelStateHash() {
    const lines = [Proj.cen.p, Proj.cen.k, Proj.cen.d, Proj.ext.p, Proj.ext.k, Proj.ext.d];
    let hash = 0;
    for (let i = 0; i < 6; i++) {
        let v = lines[i] === Y ? 2 : (lines[i] === N ? 1 : 0);
        hash += v * Math.pow(3, i);
    }
    return hash;
}

function playPanelStateSound() {
    stopCurrentSound();
    const hash = getPanelStateHash();
    const isDark = document.documentElement.dataset.theme !== 'light';
    
    const prog432 = [];
    const pent = [0, 2, 4, 7, 9];
    for (let i = 0; i < 24; i++) {
        const oct = Math.floor(i / 5);
        const n = pent[i % 5];
        const m = 45 + oct * 12 + n; 
        prog432.push(432 * Math.pow(2, (m - 69) / 12));
    }
    
    const pitchIdx = hash % 24;
    const targetFreq = prog432[pitchIdx];
    
    const variation = Math.floor(hash / 24); 
    const filterSweepMult = 1 + (variation / 30); 
    const durationMod = 1 + (variation / 60);
    
    const a = gAC();
    const t = a.currentTime;
    actOsc = a.createOscillator();
    actFilt = a.createBiquadFilter();
    actTremGain = a.createGain();
    actGain = a.createGain();
    
    actOsc.connect(actFilt);
    actFilt.connect(actTremGain);
    actTremGain.connect(actGain);
    actGain.connect(a.destination);
    
    if (!isDark) {
        // LIGHT MODE: Robby Krieger Flamenco Fretless Fender Guitar Bottleneck Slide
        actTremGain.gain.value = 1.0; 
        actOsc.type = 'sawtooth';
        actFilt.type = 'lowpass';
        actFilt.frequency.setValueAtTime(targetFreq * 1.2, t);
        actFilt.exponentialRampToValueAtTime(targetFreq * 3 * filterSweepMult, t + 0.1);
        
        actOsc.frequency.setValueAtTime(prevFreq, t);
        actOsc.frequency.exponentialRampToValueAtTime(targetFreq, t + 0.15);
        
        actVib = a.createOscillator();
        actVib.type = 'sine';
        actVib.frequency.value = 5.0 + (variation % 3);
        const vibGain = a.createGain();
        vibGain.gain.setValueAtTime(0, t);
        vibGain.gain.setValueAtTime(0, t + 0.2); 
        vibGain.gain.linearRampToValueAtTime(targetFreq * 0.02, t + 0.4);
        actVib.connect(vibGain);
        vibGain.connect(actOsc.frequency);
        actVib.start(t);
        
        const dur = 0.7 * durationMod;
        actGain.gain.setValueAtTime(0.001, t);
        actGain.gain.exponentialRampToValueAtTime(0.3, t + 0.05);
        actGain.gain.exponentialRampToValueAtTime(0.001, t + dur);
        
        actOsc.start(t);
        actOsc.stop(t + dur + 0.1);
        actVib.stop(t + dur + 0.1);
    } else {
        // DARK MODE: Mandolin String Pluck
        actOsc.type = 'triangle';
        actFilt.type = 'bandpass';
        actFilt.frequency.value = targetFreq * 2 * filterSweepMult;
        actFilt.Q.value = 1.2;
        actOsc.frequency.setValueAtTime(targetFreq, t);
        
        actVib = a.createOscillator();
        actVib.type = 'sine';
        actVib.frequency.value = 12 + (variation % 4); 
        const lfoDepth = a.createGain();
        lfoDepth.gain.value = 0.8;
        actVib.connect(lfoDepth);
        lfoDepth.connect(actTremGain.gain);
        actTremGain.gain.value = 0.5;
        actVib.start(t);
        
        const dur = 0.6 * durationMod;
        actGain.gain.setValueAtTime(0.001, t);
        actGain.gain.exponentialRampToValueAtTime(0.4, t + 0.02);
        actGain.gain.exponentialRampToValueAtTime(0.001, t + dur);
        
        actOsc.start(t);
        actOsc.stop(t + dur + 0.1);
        actVib.stop(t + dur + 0.1);
    }
    prevFreq = targetFreq;
}

function playTone() {
    playPanelStateSound();
}

