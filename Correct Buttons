const trildx = { ext: { g: 0, l: 0 }, cen: { g: 0, l: 0 } };
function cycleTri(reg, fam) {
    const tris = fam === 'g' ? GY : LY;
    const i = trildx[reg][fam];
    const t = tris[i];
    Proj[reg].d = t.d; Proj[reg].k = t.k; Proj[reg].p = t.p;
    trildx[reg][fam] = (i + 1) % tris.length;
    render();
}

function getVT(reg, fam) {
    const a = getActiveTri(reg);
    const tris = fam === 'g' ? GY : LY;
    if (a && tris.includes(a)) return a;
