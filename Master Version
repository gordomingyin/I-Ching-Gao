const dyn = {}, btnState = {}; 

function mkB(html, css, fn, title) {
    const b = document.createElement('button');
    b.className = 'gb ' + (css || '');
    b.innerHTML = html;
    if (title) b.title = title;
    b.onclick = fn;
    return b;
}

function bPC(el, p) {
    el.classList.remove('on', 'on-yin');
    if (p === Y) el.classList.add('on');
    else if (p === N) el.classList.add('on-yin');
}

function mkHex(pi) {
    if (pi >= PAIRS.length) {
        const d = document.createElement('div');
        d.className = 'gb';
        return d;
    }
    const [sa, sb] = PAIRS[pi];
    const ss = get4(sa, sb);
    if (btnState[pi] === undefined) btnState[pi] = 0;
    btnState[pi] = btnState[pi] % ss.length;
    const b = document.createElement('button');
    b.className = 'gb hz';
    b.textContent = ss[btnState[pi]].g;
    b.title = sa.z + '.' + sb.z;
    b.dataset.pi = pi;
    
    b.onclick = () => {
        let act = ss[btnState[pi]];
        const curN = linesToN();
        if (curN !== null && curN === sigToN(act)) {
            btnState[pi] = (btnState[pi] + 1) % ss.length;
            act = ss[btnState[pi]]; 
            b.textContent = act.g;
        }
        const an = sigToN(act);
        const loadSeq = [4, 1, 5, 2, 3, 0];
        const lines = getLines();
        for (let i = 0; i < loadSeq.length; i++) {
            const idx = loadSeq[i];
            const tgt = Math.floor(an / Math.pow(2, 5 - idx)) % 2;
            if (lines[idx] !== tgt) {
                const {r, n} = LM[idx];
                Proj[r][n] = tgt === 1 ? Y : N;
                render();
                playTone();
                break;
            }
        }
        refreshHL();
    };
    return b;
}

function refreshHL() {
    const curN = linesToN();
    document.querySelectorAll('.gb.hz[data-pi]').forEach(b => {
        const pi = parseInt(b.dataset.pi);
        if (isNaN(pi) || pi >= PAIRS.length) return;
        const ss = get4(PAIRS[pi][0], PAIRS[pi][1]);
        b.classList.toggle('matched', !!(curN !== null && ss.some(s => sigToN(s) === curN)));
    });
}

function buildGrid() {
    const grid = document.getElementById('btn-grid');
    grid.innerHTML = '';
    
    dyn.eYao = mkB(dN(Proj.ext.k), 'yao', tUY);
    dyn.cYao = mkB(dN(Proj.cen.k), 'yao', tLY);
    
    dyn.eU = mkB(dL(Proj.ext.k, Proj.ext.d), 'dgr', tEU);
    dyn.eL = mkB(dL(Proj.ext.p, Proj.ext.k), 'dgr', tEL);
    dyn.cU = mkB(dL(Proj.cen.k, Proj.cen.d), 'dgr', tCU);
    dyn.cL = mkB(dL(Proj.cen.p, Proj.cen.k), 'dgr', tCL);
    
    dyn.eTG = mkB('', 'tri', () => cycleTri('ext', 'g'));
    dyn.eTL = mkB('', 'tri', () => cycleTri('ext', 'l'));
    dyn.cTG = mkB('', 'tri', () => cycleTri('cen', 'g'));
    dyn.cTL = mkB('', 'tri', () => cycleTri('cen', 'l'));
    
    dyn.midToggle = mkB('⽘', 'yao', toggleBothMiddleYaos, '翻轉雙中⽘ (Toggle upper and lower middle yaos)');
    dyn.midSwap = mkB('⽘', 'yao', swapMiddleYaos, '交換雙中⽘ (Swap upper and lower middle yaos)');
    
    function pl(el, col, row) {
        el.style.gridColumn = col;
        el.style.gridRow = row;
        grid.appendChild(el);
    }
    
    pl(dyn.cYao, 5, 1);
    pl(dyn.cU, 6, 1);
    pl(dyn.eU, 7, 1);
    pl(dyn.eYao, 8, 1);
    
    pl(dyn.cL, 5, 2);
    pl(dyn.cTG, 6, 2);
    pl(dyn.eTL, 7, 2);
    pl(dyn.eL, 8, 2);
    
    pl(dyn.cTL, 5, 3);
    pl(dyn.eTG, 8, 3);
    
    pl(dyn.midToggle, 5, 4);
    pl(dyn.midSwap, 8, 4);
    
    const md = document.createElement('div');
    md.id = 'mini-display';
    md.style.gridColumn = '6/8';
    md.style.gridRow = '3/5';
    grid.appendChild(md);
    
    for (let row = 0; row < 4; row++) {
        for (let i = 0; i < 4; i++) {
            const bL = mkHex(row * 4 + i);
            bL.style.gridColumn = i + 1;
            bL.style.gridRow = row + 1;
            grid.appendChild(bL);
            
            const bR = mkHex(16 + row * 4 + i);
            bR.style.gridColumn = i + 9;
            bR.style.gridRow = row + 1;
            grid.appendChild(bR);
        }
    }
    refreshBG();
}

function refreshBG() {
    const ep = Proj.ext, cp = Proj.cen;
    if (dyn.eYao) { dyn.eYao.innerHTML = dN(ep.k); bPC(dyn.eYao, ep.k); }
    if (dyn.cYao) { dyn.cYao.innerHTML = dN(cp.k); bPC(dyn.cYao, cp.k); }
    
    if (dyn.eU) {
        dyn.eU.innerHTML = dL(ep.k, ep.d);
        dyn.eU.classList.toggle('on', ep.d === Y);
        dyn.eU.classList.toggle('on-yin', ep.d === N);
    }
    if (dyn.eL) {
        dyn.eL.innerHTML = dL(ep.p, ep.k);
        dyn.eL.classList.toggle('on', ep.p === Y);
        dyn.eL.classList.toggle('on-yin', ep.p === N);
    }
    if (dyn.cU) {
        dyn.cU.innerHTML = dL(cp.k, cp.d);
        dyn.cU.classList.toggle('on', cp.d === Y);
        dyn.cU.classList.toggle('on-yin', cp.d === N);
    }
    if (dyn.cL) {
        dyn.cL.innerHTML = dL(cp.p, cp.k);
        dyn.cL.classList.toggle('on', cp.p === Y);
        dyn.cL.classList.toggle('on-yin', cp.p === N);
    }
    
    const eT = getActiveTri('ext'), cT = getActiveTri('cen');
    if (dyn.eTG) { dyn.eTG.innerHTML = dT(getVT('ext', 'g')); dyn.eTG.classList.toggle('on', !!(eT && GY.includes(eT))); }
    if (dyn.eTL) { dyn.eTL.innerHTML = dT(getVT('ext', 'l')); dyn.eTL.classList.toggle('on-yin', !!(eT && LY.includes(eT))); }
    if (dyn.cTG) { dyn.cTG.innerHTML = dT(getVT('cen', 'g')); dyn.cTG.classList.toggle('on', !!(cT && GY.includes(cT))); }
    if (dyn.cTL) { dyn.cTL.innerHTML = dT(getVT('cen', 'l')); dyn.cTL.classList.toggle('on-yin', !!(cT && LY.includes(cT))); }
    
    if (dyn.midToggle) {
        const eq = (ep.k === cp.k);
        if (ep.k !== V && cp.k !== V) {
            dyn.midToggle.classList.toggle('on', eq);
            dyn.midToggle.classList.toggle('on-yin', !eq);
        } else {
            dyn.midToggle.classList.remove('on', 'on-yin');
        }
    }
    if (dyn.midSwap) {
        const diff = (ep.k !== cp.k && ep.k !== V && cp.k !== V);
        dyn.midSwap.classList.toggle('matched', diff);
    } 
    refreshHL();
    updateMini();
}

let activeTarget = null, isTraining = false, streak = 0, totalN = 0, state = 'idle';
let cascadeQ = [], cascadeIdx = 0, cascadeTimer = null, mode = 'B';
const MS = { B: [3, 5, 7], I: [6, 12, 16, 24], M: [32, 48, 64] };
let modeIdx = 0, missed = [], inRem = false, seqLen = 3, seq = [], seqIdx = 0;
const MXDUR = 1100, MNDUR = 130;

const FB = {
    idle: { l: 'ℵ₀', c: 's-null' },
    flashing: { l: 'ℵ₀', c: 's-null' },
    building: { l: 'ℵ', c: 's-build' },
    'result-ok': { l: 'ℵ ∴', c: 's-ok' },
    'result-err': { l: 'ℵ', c: 's-err' },
    cascade: { l: 'ℵ₁', c: 's-ok' }
};

function updateFlashBtn() {
    const s = FB[state] || FB.idle, b = document.getElementById('flash-btn');
    b.textContent = s.l;
    b.className = s.c;
}

function genSeq() {
    seq = [];
    for (let i = 0; i < seqLen; i++) seq.push(SIGS[Math.floor(Math.random() * 64)]);
    seqIdx = 0;
}

function doFlash() {
    toggleOff(true);
    if (!seq.length || seqIdx >= seqLen) genSeq();
    activeTarget = seq[seqIdx];
    hideSP();
    
    document.getElementById('yao-display').classList.remove('glow');
    document.getElementById('mini-display').classList.remove('glow');
    
    const ft = document.getElementById('flash-target');
    ft.textContent = activeTarget.g;
    ft.classList.add('show');
    sndHex(activeTarget);
    state = 'flashing';
    render();
    
    const dur = Math.max(MNDUR, MXDUR - streak * 55) + Math.floor(Math.random() * 80);
    setTimeout(() => {
        ft.classList.remove('show');
        isTraining = true;
        state = 'building';
        toggleOff(true);
    }, dur);
}

