        c.appendChild(r);
    });
}

function doSubmit() {
    if (!isTraining || voidCount() > 0) return;
    const inp = getResolvedSig();
    isTraining = false;
    seqIdx++;
    
    const ft = document.getElementById('flash-target');
    ft.textContent = activeTarget.g;
    ft.classList.add('show');
