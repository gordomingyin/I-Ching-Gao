    if (inp === activeTarget) {
        streak++;
        totalN++;
        document.getElementById('sv').textContent = streak;
        document.getElementById('tv').textContent = totalN;
        sndOK();
        state = 'result-ok';
        applyProj(activeTarget);
        
        const yd = document.getElementById('yao-display');
