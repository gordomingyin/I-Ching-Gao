let ac = null;
function gAC() {
    if (!ac) ac = new (window.AudioContext || window.webkitAudioContext)();
    if (ac.state === 'suspended') ac.resume();
    return ac;
}

function hz(m) { return 432 * Math.pow(2, (m - 69) / 12); }

function osc(m, t, d, vol, delay, glide) {
    try {
        const a = gAC(), o = a.createOscillator(), g = a.createGain(), st = a.currentTime + (delay || 0);
        o.type = t;
        
        if (glide) {
            o.frequency.setValueAtTime(hz(m - 12), st);
            o.frequency.exponentialRampToValueAtTime(hz(m), st + 0.2);
        } else {
            o.frequency.setValueAtTime(hz(m), st);
        }
        
        g.gain.setValueAtTime(0.0001, st);
        g.gain.exponentialRampToValueAtTime(vol, st + 0.015);
        g.gain.exponentialRampToValueAtTime(0.001, st + d);
        o.connect(g);
        g.connect(a.destination);
        o.start(st); 
        o.stop(st + d + 0.05);
    } catch (e) {}
}

function sndHex(sig) {
    const i = SIGS.indexOf(sig);
    if (i < 0) return;
    const isLight = document.documentElement.dataset.theme === 'light';
    osc(36 + i, 'sine', 0.6, 0.13, 0, isLight);
}

function sndTri(t, e) {
    const i = TSEQ.indexOf(t);
    const isLight = document.documentElement.dataset.theme === 'light';
    osc((e ? 60 : 48) + i * 2, 'triangle', 0.45, 0.11, 0, isLight);
}

function sndSX(a, b, e) {
    if (a === V || b === V) return;
    const dg = (a === Y ? 1 : 0) * 2 + (b === Y ? 1 : 0);
    const isLight = document.documentElement.dataset.theme === 'light';
    osc((e ? 55 : 43) + [0, 3, 5, 7][dg], 'triangle', 0.32, 0.1, 0, isLight);
}

function sndYao(p, e) {
    const isLight = document.documentElement.dataset.theme === 'light';
    osc((e ? 48 : 36) + (p === Y ? 7 : 0), 'sine', 0.22, 0.09, 0, isLight);
}

function sndOK() { 
    const isLight = document.documentElement.dataset.theme === 'light';
    osc(72, 'sine', 0.5, 0.12, 0, isLight); 
}
function sndFail() { 
    const isLight = document.documentElement.dataset.theme === 'light';
    osc(36, 'square', 0.4, 0.12, 0, isLight); 
}
function sndReset() { 
    const isLight = document.documentElement.dataset.theme === 'light';
    osc(30, 'sawtooth', 0.25, 0.1, 0, isLight); 
} 
function sndRestart() { 
    const isLight = document.documentElement.dataset.theme === 'light';
    osc(24, 'sawtooth', 0.5, 0.12, 0, isLight); 
}
function sndApex() {
    const isLight = document.documentElement.dataset.theme === 'light';
    osc(48, 'sine', 0.8, 0.12, 0, isLight);
}

function playTone() {
    const cur = getResolvedSig();
    if (cur) { sndHex(cur); return; }
    
    const eT = getActiveTri('ext'), cT = getActiveTri('cen');
    if (eT) { sndTri(eT, true); return; }
    if (cT) { sndTri(cT, false); return; }
    
    const ep = Proj.ext, cp = Proj.cen;
    if (ep.k !== V) {
        if (ep.d !== V) sndSX(ep.k, ep.d, true);
        else if (ep.p !== V) sndSX(ep.p, ep.k, true);
        else sndYao(ep.k, true);
        return;
    }
    if (cp.k !== V) {
        if (cp.d !== V) sndSX(cp.k, cp.d, false);
        else if (cp.p !== V) sndSX(cp.p, cp.k, false);
        else sndYao(cp.k, false);
        return;
    } 
}

