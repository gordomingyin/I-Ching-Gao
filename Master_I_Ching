<!DOCTYPE html>      
<html lang="zh-TW" data-theme="dark">      
<head>      
<meta charset="UTF-8">      
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">      
<title>卦算 | Ching Training Matrix</title>      
<link href="https://fonts.googleapis.com/css2?family=Zhi+Mang+Xing&family=Ma+Shan+Zheng&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">      
<style>      
:root{--bg:#06070b;--s0:#0a0b10;--bd:#1a1c26;--yang:#c8a96e;--yin:#4d7a96;--jade:#3d9e78;--ember:#b85540;--t0:#ddd8ce;--t1:#8a8278;--t2:#3e3a34;}      
html[data-theme="light"]{--bg:#f4f0e8;--s0:#ebe5d8;--bd:#ccc4b0;--yang:#7a5c1a;--yin:#1a4a6a;--jade:#1a6040;--ember:#8a2015;--t0:#1a1610;--t1:#5a5040;--t2:#c0b898;}      
*::before,*::after,*{box-sizing:border-box;margin:0;padding:0}      
html,body{height:100dvh;width:100%;overflow:hidden;background:var(--bg);color:var(--t0);transition:background .3s ease,color .3s ease}      
body{display:flex;justify-content:center;font-family:'Ma Shan Zheng',cursive;margin:0}      
  
#app{width:100%;max-width:430px;height:100dvh;display:flex;flex-direction:column;position:relative}      
#ink-cloud{position:absolute;inset:0;z-index:100;opacity:0;pointer-events:none;background:radial-gradient(circle at 50% 50%,rgba(2,2,4,.98) 0%,rgba(6,7,11,.92) 100%);transition:opacity 1.8s cubic-bezier(.1,.9,.2,1)}      
#ink-cloud.show{opacity:1;transition:none}      
#display{flex:1;min-height:0;display:flex;position:relative;z-index:10}      
#panel-err{flex:1;position:relative;overflow:hidden;background:var(--bg);border-right:1px solid var(--bd);opacity:0;pointer-events:none;transition:opacity .2s}      
#panel-err.show{opacity:1;pointer-events:auto}      
  
.ep-in{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:5px;padding:6px 4px}      
.ep-glyphs{display:flex;align-items:center;justify-content:center;gap:10px}      
.ep-g{font-family:'Zhi Mang Xing',cursive;font-size:clamp(26px,8vw,42px);line-height:1}      
.ep-g.u{color:var(--ember)}.ep-g.t{color:var(--jade)}      
.ep-df{width:100%;overflow-y:auto;max-height:52%}      
.ep-row{display:flex;align-items:center;gap:3px;padding:2px;margin-bottom:2px;border:1px solid transparent}      
.ep-row.bad{background:rgba(168,64,48,.07);border-color:rgba(168,64,48,.2)}      
.ep-row.ok{opacity:.13}      
.ep-ln{flex:1;height:4px;display:flex}      
.ep-dy{width:100%;height:4px;background:var(--yang)}      
.ep-dn{width:100%;display:flex;gap:22%;height:4px}      
.ep-dnb{flex:1;height:4px;background:var(--yin)}      
  
#panel-center{flex:1;position:relative;overflow:hidden;background:var(--bg)}      
#flash-target{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'Zhi Mang Xing',cursive;font-size:clamp(110px,28vw,190px);line-height:1;color:#fff;text-shadow:0 0 40px rgba(200,169,110,.9);pointer-events:none;opacity:0;transition:opacity .8s;z-index:20}      
#flash-target.show{opacity:1}      
@keyframes plasmaWave{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}      
html[data-theme="light"] #flash-target{background:linear-gradient(60deg,#ff1461,#ff7a00,#b000ff,#ff1461);background-size:300% 300%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;color:transparent;text-shadow:none;filter:drop-shadow(0 0 15px rgba(255,20,97,.45));animation:plasmaWave 2s ease infinite}      
  
#yao-frame{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:2}      
#yao-display{display:flex;flex-direction:column;gap:5px}      
.yl{cursor:pointer;transition:opacity .1s}.yl:hover{opacity:.75}      
.yl-yang{width:100%;border-radius:1px;background:linear-gradient(to right,transparent 2%,var(--yang) 18%,rgba(255,248,200,.9) 50%,var(--yang) 82%,transparent 98%);box-shadow:0 0 8px var(--yang),0 0 18px rgba(200,169,110,.2)}      
.yl-yin{width:100%;display:flex;gap:18%}      
.yl-yin-b{flex:1;border-radius:1px}      
.yl-yin-b:first-child{background:linear-gradient(to right,var(--yin) 0%,rgba(77,122,150,.5) 60%,transparent 100%);box-shadow:2px 0 8px rgba(77,122,150,.5)}      
.yl-yin-b:last-child{background:linear-gradient(to left,var(--yin) 0%,rgba(77,122,150,.5) 60%,transparent 100%);box-shadow:2px 0 8px rgba(77,122,150,.5)}      
.yl-blank{width:100%;border:1px solid var(--bd);border-radius:2px;opacity:.18}      
.glow .yl-yang{background:linear-gradient(to right,transparent 2%,var(--jade) 18%,rgba(180,255,200,.9) 50%,var(--jade) 82%,transparent 98%);box-shadow:0 0 18px rgba(61,158,120,.8)}      
.glow .yl-yin-b{box-shadow:0 0 12px rgba(61,158,120,.6);background:var(--jade)!important}      
.glow .yl[data-i="2"],.glow .yl[data-i="3"]{animation:emerge .15s ease-out both}      
.glow .yl[data-i="1"],.glow .yl[data-i="4"]{animation:emerge .15s ease-out .07s both}      
.glow .yl[data-i="0"],.glow .yl[data-i="5"]{animation:emerge .15s ease-out .14s both}      
@keyframes emerge{from{opacity:0;transform:scaleX(.4)}to{opacity:1;transform:scaleX(1)}}      
  
#panel-right{flex:1;position:relative;overflow:hidden;background:var(--bg);border-left:1px solid var(--bd);opacity:0;pointer-events:none;transition:opacity .25s;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:8px 4px}      
#panel-right.show{opacity:1}      
#ri-sym{font-family:'Zhi Mang Xing',cursive;font-size:clamp(40px,10vw,68px);color:var(--yang);line-height:1;filter:drop-shadow(0 0 10px rgba(200,169,110,.3))}      
#ri-name{font-family:'Zhi Mang Xing',cursive;font-size:clamp(14px,4vw,22px)}      
#ri-pin{font-family:'Space Mono',monospace;font-size:clamp(7px,2vw,10px);color:var(--t1);font-style:italic}      
#ri-tri{font-size:clamp(17px,5.5vw,26px);line-height:1;color:var(--t1);letter-spacing:.22em}      
#ri-yao{font-family:'Space Mono','Ma Shan Zheng',monospace;font-size:10px;color:var(--t2);text-align:center;max-height:85px;overflow-y:auto;width:95%;line-height:1.2}      
  
#btn-grid{flex:0 0 22dvh;display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:repeat(4,1fr);border-top:1px solid var(--bd)}      
.gb{display:flex;align-items:center;justify-content:center;font-size:9px;cursor:pointer;color:var(--t2);border:1px solid #0c0c0e;user-select:none;line-height:1;overflow:hidden;background:var(--bg);font-family:'Zhi Mang Xing',cursive;-webkit-tap-highlight-color:transparent;transition:all .15s ease}      
.gb:active,.gb.on{color:var(--yang);background:rgba(200,169,110,.05)}      
.gb.on-yin{color:var(--yin);background:rgba(77,122,150,.05)}      
.gb.matched{color:var(--jade);background:rgba(61,158,120,.07)}      
.gb.hz{font-size:14px}.gb.tri{font-size:11px}.gb.dgr{font-size:10px}.gb.yao{font-size:12px}      
#mini-display{background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:6px 5px;border:1px solid var(--bd);gap:0}      
#ctrl{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:2px;background:var(--s0);border-top:1px solid var(--bd);padding:5px 6px;flex-wrap:nowrap}      
.cb{font-family:'Zhi Mang Xing',cursive;font-size:12px;background:transparent;border:1px solid var(--bd);color:var(--t1);cursor:pointer;border-radius:2px;padding:3px 5px;user-select:none;line-height:1;flex-shrink:0}      
.cb:active{color:var(--yang);border-color:var(--yang)}      
.cb.dng{font-size:16px;padding:5px 8px}      
.cb.dng:active{color:var(--ember);border-color:var(--ember)}      
  
#flash-btn{font-family:'Space Mono',system-ui,sans-serif;font-size:20px;font-weight:700;padding:6px 16px;border:none;border-radius:2px;cursor:pointer;flex-shrink:0;line-height:1;transition:all .2s ease}      
#flash-btn.s-null{background:var(--yang);color:#000}      
#flash-btn.s-build{background:transparent;color:var(--yang);border:1px solid rgba(200,169,110,.4)}      
#flash-btn.s-ok{background:transparent;color:var(--jade);border:1px solid rgba(61,158,120,.4)}      
#flash-btn.s-err{background:transparent;color:var(--ember);border:1px solid rgba(168,64,48,.3)}      
#hex-icon{font-family:'Zhi Mang Xing',cursive;font-size:30px;line-height:1;background:none;border:none;cursor:pointer;color:var(--t2);opacity:.35;flex-shrink:0;min-width:28px;text-align:center}      
#hex-icon.matched{color:var(--jade);opacity:1}      
.sc-item{display:flex;flex-direction:column;align-items:center;flex-shrink:0}      
.sc-v{font-family:'Space Mono',monospace;font-size:9px;font-weight:700;color:var(--yang)}      
.sc-l{font-family:'Ma Shan Zheng',cursive;font-size:7px;color:var(--t2)}      
.ds{display:flex;gap:2px}      
.db{font-family:'Ma Shan Zheng',cursive;font-size:10px;background:transparent;color:var(--t2);border:1px solid var(--bd);padding:2px 3px;cursor:pointer;border-radius:2px;flex-shrink:0}      
.db.on{color:var(--yang);border-color:rgba(200,169,110,.3)}      
#theme-btn{font-size:13px;background:transparent;border:none;cursor:pointer;color:var(--t1);flex-shrink:0;padding:2px 4px;line-height:1}      
#theme-btn:active{color:var(--yang)}      
</style>      
</head>      
<body>      
<div id="app">      
<div id="ink-cloud"></div>      
<div id="display">      
  <div id="panel-err">      
    <div class="ep-in">      
      <div class="ep-glyphs"><span id="eu-g" class="ep-g u"></span><span id="et-g" class="ep-g t"></span></div>      
      <div class="ep-df" id="ep-diffs"></div>      
    </div>      
  </div>      
  <div id="panel-center">      
    <div id="flash-target"></div>      
    <div id="yao-frame"><div id="yao-display"></div></div>      
  </div>      
  <div id="panel-right">      
    <div id="ri-sym"></div><div id="ri-name">-</div><div id="ri-pin">-</div><div id="ri-tri">-</div><div id="ri-yao">-</div>      
  </div>      
</div>      
<div id="btn-grid"></div>      
  
<div id="ctrl">      
  <button class="cb" onclick="toggleOff()" title="清空 Wuji">◯</button>      
  <button class="cb" onclick="totalFlip()" title="翻轉 Flip active">↻</button>      
  <button class="cb" onclick="invertHex()" title="錯卦 Complement">➰</button>      
  <button class="cb" onclick="flipTopBottom()" title="綜卦 Reverse">⼋</button>      
  <button class="cb" onclick="swapTrigrams()" title="交卦 Swap">⇅</button>      
  <button id="hex-icon" onclick="speakCurrent()" title="語音"></button>      
  <button id="flash-btn" class="s-null" onclick="handleFlash()"></button>      
  <button class="cb dng" onclick="doReset()" title="重置">↺</button>      
  <button class="cb dng" onclick="doRestart()" title="重啟">⚠</button>      
  <div class="sc-item"><div class="sc-v" id="sv">0</div><div class="sc-l">連</div></div>      
  <div class="sc-item"><div class="sc-v" id="tv">0</div><div class="sc-l">節</div></div>      
  <div class="ds">      
    <button class="db on" id="dB" onclick="setMode('B')">初</button>      
    <button class="db" id="dI" onclick="setMode('I')">中</button>      
    <button class="db" id="dM" onclick="setMode('M')">師</button>      
  </div>      
  <button id="theme-btn" onclick="toggleTheme()" title="主題">ש</button>      
</div>      
</div>      
      
<script>      
const Y='YANG',N='YIN',V=null;      
const GY=[],LY=[];      
const T={      
  QIAN:{id:'QIAN',g:'☰',z:'乾',d:Y,k:Y,p:Y},XUN:{id:'XUN',g:'☴',z:'巽',d:Y,k:Y,p:N},      
  LI:{id:'LI',g:'☲',z:'離',d:Y,k:N,p:Y},GEN:{id:'GEN',g:'☶',z:'艮',d:Y,k:N,p:N},      
  DUI:{id:'DUI',g:'☱',z:'兌',d:N,k:Y,p:Y},KAN:{id:'KAN',g:'☵',z:'坎',d:N,k:Y,p:N},      
  ZHEN:{id:'ZHEN',g:'☳',z:'震',d:N,k:N,p:Y},KUN:{id:'KUN',g:'☷',z:'坤',d:N,k:N,p:N}      
};      
    
const TSEQ=[T.LI, T.KAN, T.DUI, T.GEN, T.XUN, T.ZHEN, T.KUN, T.QIAN];      
TSEQ.forEach(t=>{if(t.k===Y)GY.push(t);else LY.push(t);});      
    
const RAW=[      
  "LI,LI,29,離,lí", "LI,KAN,63,未濟,wèi jì", "LI,DUI,37,睽,kuí", "LI,GEN,55,旅,lǚ",      
  "LI,XUN,49,鼎,dǐng", "LI,ZHEN,20,噬嗑,shì kè", "LI,KUN,34,晉,jìn", "LI,QIAN,13,大有,dà yǒu",      
  "KAN,LI,62,既濟,jì jì", "KAN,KAN,28,坎,kǎn", "KAN,DUI,59,節,jié", "KAN,GEN,38,蹇,jiǎn",      
  "KAN,XUN,47,井,jǐng", "KAN,ZHEN,2,屯,zhūn", "KAN,KUN,7,比,bǐ", "KAN,QIAN,4,需,xū",      
  "DUI,LI,48,革,gé", "DUI,KAN,46,困,kùn", "DUI,DUI,57,兌,duì", "DUI,GEN,30,咸,xián",      
  "DUI,XUN,27,大過,dà guò", "DUI,ZHEN,16,隨,suí", "DUI,KUN,44,萃,cuì", "DUI,QIAN,42,夬,guài",      
  "GEN,LI,21,賁,bì", "GEN,KAN,3,蒙,méng", "GEN,DUI,40,損,sǔn", "GEN,GEN,51,艮,gèn",      
  "GEN,XUN,17,蠱,gǔ", "GEN,ZHEN,26,頤,yí", "GEN,KUN,22,剝,bō", "GEN,QIAN,25,大畜,dà xù",      
  "XUN,LI,36,家人,jiā rén", "XUN,KAN,58,渙,huàn", "XUN,DUI,60,中孚,zhōng fú", "XUN,GEN,52,漸,jiàn",      
  "XUN,XUN,56,巽,xùn", "XUN,ZHEN,41,益,yì", "XUN,KUN,19,觀,guān", "XUN,QIAN,8,小畜,xiǎo xù",      
  "ZHEN,LI,54,豐,fēng", "ZHEN,KAN,39,解,jiě", "ZHEN,DUI,53,歸妹,guī mèi", "ZHEN,GEN,61,小過,xiǎo guò",      
  "ZHEN,XUN,31,恆,héng", "ZHEN,ZHEN,50,震,zhèn", "ZHEN,KUN,15,豫,yù", "ZHEN,QIAN,33,大壯,dà zhuàng",      
  "KUN,LI,35,明夷,míng yí", "KUN,KAN,6,師,shī", "KUN,DUI,18,臨,lín", "KUN,GEN,14,謙,qiān",      
  "KUN,XUN,45,升,shēng", "KUN,ZHEN,23,復,fù", "KUN,KUN,1,坤,kūn", "KUN,QIAN,10,泰,tài",      
  "QIAN,LI,12,同人,tóng rén", "QIAN,KAN,5,訟,sòng", "QIAN,DUI,9,履,lǚ", "QIAN,GEN,32,遯,dùn",      
  "QIAN,XUN,43,姤,gòu", "QIAN,ZHEN,24,無妄,wú wàng", "QIAN,KUN,11,否,pǐ", "QIAN,QIAN,0,乾,qián"      
];      
    
const SIGS=RAW.map((s)=>{      
  const[e,c,idx,z,p]=s.split(',');      
  const kwIdx = parseInt(idx.trim());    
  return{ext:T[e.trim()],cen:T[c.trim()],id:`${e.trim()}-${c.trim()}`,g:String.fromCharCode(0x4DC0+kwIdx),z:z.trim(),p:p.trim()};      
});      
const LM=[{r:'cen',n:'p'},{r:'cen',n:'k'},{r:'cen',n:'d'},{r:'ext',n:'p'},{r:'ext',n:'k'},{r:'ext',n:'d'}];      
  
function sigToN(s){return(s.cen.p===Y?32:0)+(s.cen.k===Y?16:0)+(s.cen.d===Y?8:0)+(s.ext.p===Y?4:0)+(s.ext.k===Y?2:0)+(s.ext.d===Y?1:0);}      
function invN(n){return 63-n;}      
function flipN(n){let r=0;for(let i=0;i<6;i++)r+=(Math.floor(n/Math.pow(2,i))%2)*Math.pow(2,5-i);return r;}      
const PAIRS=[];const _sp=new Set();      
SIGS.forEach(sig=>{      
  if(_sp.has(sig.id))return;      
  const n=sigToN(sig),fn=flipN(n),pn=fn!==n?fn:invN(n);      
  const pair=SIGS.find(s=>sigToN(s)===pn)||sig;      
  _sp.add(sig.id);_sp.add(pair.id);PAIRS.push([sig,pair]);      
});      
      
function get4(sa,sb){      
  const raw=[sa,SIGS.find(s=>sigToN(s)===invN(sigToN(sa)))||sa,sb,SIGS.find(s=>sigToN(s)===invN(sigToN(sb)))||sb];      
  const out=[],seen=new Set();for(const x of raw)if(!seen.has(x.id)){seen.add(x.id);out.push(x);}return out;      
}      
      
let Proj={ext:{d:V,k:V,p:V},cen:{d:V,k:V,p:V}};      
function getLines(){return LM.map(m=>Proj[m.r][m.n]===Y?1:(Proj[m.r][m.n]===N?0:null));}      
function linesToN(){const l=getLines();return l.some(v=>v===null)?null:l[0]*32+l[1]*16+l[2]*8+l[3]*4+l[4]*2+l[5];}      
      
function togP(c) {    
    if (c === V) return N;    
    if (c === N) return Y;    
    return V;    
}     
function invP(p){return p===V?V:(p===Y?N:Y);}      
function getActiveTri(r){const s=Proj[r];if(s.d===V||s.k===V||s.p===V)return null;return Object.values(T).find(t=>t.d===s.d&&t.k===s.k&&t.p===s.p);}      
function getResolvedSig(){const e=getActiveTri('ext'),c=getActiveTri('cen');if(!e||c==null)return null;return SIGS.find(s=>s.ext===e&&s.cen===c);}      
function voidCount(){let n=0;for(const r of['ext','cen'])for(const k of['d','k','p'])if(Proj[r][k]===V)n++;return n;}      
function applyProj(sig){Proj.ext.d=sig.ext.d;Proj.ext.k=sig.ext.k;Proj.ext.p=sig.ext.p;Proj.cen.d=sig.cen.d;Proj.cen.k=sig.cen.k;Proj.cen.p=sig.cen.p;}      
      
function toggleOff(silent){Proj={ext:{d:V,k:V,p:V},cen:{d:V,k:V,p:V}};if(!silent)sndReset();render();}      
function totalFlip(){for(const r of['ext','cen'])for(const n of['d','k','p'])if(Proj[r][n]!==V)Proj[r][n]=invP(Proj[r][n]);render();}      
function invertHex(){if(voidCount()>0)return;for(const r of['ext','cen'])for(const n of['d','k','p'])Proj[r][n]=invP(Proj[r][n]);render();}      
function flipTopBottom(){const ed=Proj.ext.d,ek=Proj.ext.k,ep=Proj.ext.p,cd=Proj.cen.d,ck=Proj.cen.k,cp=Proj.cen.p;Proj.ext.d=cp;Proj.ext.k=ck;Proj.ext.p=cd;Proj.cen.d=ep;Proj.cen.k=ek;Proj.cen.p=ed;render();}      
function swapTrigrams(){const t={...Proj.ext};Proj.ext={...Proj.cen};Proj.cen=t;render();}      
function flipLine(i){const{r,n}=LM[i];Proj[r][n]=togP(Proj[r][n]);render();}      
      
function cycleUpperSX(r) {  
    let bv = Proj[r].k, tv = Proj[r].d;  
    const state = (bv === Y ? 'Y' : (bv === N ? 'N' : 'V')) + (tv === Y ? 'Y' : (tv === N ? 'N' : 'V'));  
  
    switch (state) {  
        case 'VV': bv = N; tv = Y; break; // Default to Yin base: Lesser Yang  
        case 'NY': bv = N; tv = N; break; // Lesser Yang -> Greater Yin  
        case 'NN': bv = Y; tv = N; break; // Greater Yin -> Lesser Yin  
        case 'YN': bv = Y; tv = Y; break; // Lesser Yin -> Greater Yang  
        case 'YY': bv = V; tv = V; break; // Greater Yang -> Empty/Clear  
        case 'NV': bv = N; tv = Y; break; // Partial: Base Yin -> Lesser Yang  
        case 'YV': bv = Y; tv = N; break; // Partial: Base Yang -> Lesser Yin  
        case 'VN': bv = N; tv = N; break; // Partial: Top Yin -> Greater Yin  
        case 'VY': bv = Y; tv = Y; break; // Partial: Top Yang -> Greater Yang  
        default: bv = V; tv = V; break;  
    }  
  
    Proj[r].k = bv; Proj[r].d = tv;  
    render();  
}  
  
function cycleLowerSX(r) {  
    let bv = Proj[r].p, tv = Proj[r].k;  
    const state = (bv === Y ? 'Y' : (bv === N ? 'N' : 'V')) + (tv === Y ? 'Y' : (tv === N ? 'N' : 'V'));  
  
    switch (state) {  
        case 'VV': bv = Y; tv = N; break; // Default: Lesser Yin  
        case 'YN': bv = N; tv = N; break; // Lesser Yin -> Greater Yin  
        case 'NN': bv = N; tv = Y; break; // Greater Yin -> Lesser Yang  
        case 'NY': bv = Y; tv = Y; break; // Lesser Yang -> Greater Yang  
        case 'YY': bv = V; tv = V; break; // Greater Yang -> Clear  
  
        case 'VN': bv = Y; tv = N; break; // Core Yin preset -> Lesser Yin  
        case 'VY': bv = N; tv = Y; break; // Core Yang preset -> Lesser Yang  
  
