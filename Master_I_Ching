function playPanelStateSound(){      
  stopAllAudio();      
  const hash=getPanelStateHash();      
  const isDark=document.documentElement.dataset.theme!=='light';      
  const pent=[0,2,4,7,9];      
  const prog=[];      
  for(let i=0;i<24;i++){const oct=Math.floor(i/5),n=pent[i%5],m=45+oct*12+n;prog.push(432*Math.pow(2,(m-69)/12));}      
  const pitchIdx=hash%24,targetFreq=prog[pitchIdx],variation=Math.floor(hash/24);      
  const filterMult=1+(variation/30),durMod=1+(variation/60);      
  const a=gAC();      
  const ny=a.sampleRate?a.sampleRate/2:22050;      
  const sF=f=>{const v=Number(f);if(isNaN(v)||v<=0)return 1;return Math.min(v,ny-10);};      
  const t=a.currentTime;      
  actOsc=a.createOscillator();actFilt=a.createBiquadFilter();      
  actTremGain=a.createGain();actGain=a.createGain();      
  actOsc.connect(actFilt);actFilt.connect(actTremGain);actTremGain.connect(actGain);actGain.connect(a.destination);      
  if(!isDark){      
    actTremGain.gain.value=1.0;actOsc.type='sawtooth';actFilt.type='lowpass';      
    actFilt.frequency.setValueAtTime(sF(targetFreq*1.2),t);      
    actFilt.frequency.exponentialRampToValueAtTime(sF(targetFreq*3*filterMult),t+0.1);      
    actOsc.frequency.setValueAtTime(sF(prevFreq),t);      
    actOsc.frequency.exponentialRampToValueAtTime(sF(targetFreq),t+0.15);      
    actVib=a.createOscillator();actVib.type='sine';actVib.frequency.value=5.0+(variation%3);      
    const vg=a.createGain();vg.gain.setValueAtTime(0,t);vg.gain.setValueAtTime(0,t+0.2);      
    vg.gain.linearRampToValueAtTime(targetFreq*0.02,t+0.4);      
    actVib.connect(vg);vg.connect(actOsc.frequency);actVib.start(t);      
    const dur=0.7*durMod;      
    actGain.gain.setValueAtTime(0.001,t);actGain.gain.exponentialRampToValueAtTime(0.3,t+0.05);      
    actGain.gain.exponentialRampToValueAtTime(0.001,t+dur);      
    actOsc.start(t);actOsc.stop(t+dur+0.1);actVib.stop(t+dur+0.1);      
  }else{      
    actOsc.type='triangle';actFilt.type='bandpass';      
    actFilt.frequency.value=sF(targetFreq*2*filterMult);actFilt.Q.value=1.2;      
    actOsc.frequency.setValueAtTime(sF(targetFreq),t);      
    actVib=a.createOscillator();actVib.type='sine';actVib.frequency.value=12+(variation%4);      
    const lg=a.createGain();lg.gain.value=0.8;actVib.connect(lg);lg.connect(actTremGain.gain);      
    actTremGain.gain.value=0.5;actVib.start(t);      
