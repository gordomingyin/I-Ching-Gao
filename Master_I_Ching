  sndHex(activeTarget);state='flashing';render();      
  const dur=Math.max(MNDUR,MXDUR-streak*55)+Math.floor(Math.random()*80);      
  setTimeout(()=>{ft.classList.remove('show');isTraining=true;state='building';toggleOff(true);},dur);      
}      
function showErr(inp){      
  document.getElementById('panel-err').classList.add('show');      
  document.getElementById('eu-g').textContent=inp?inp.g:'';document.getElementById('et-g').textContent=activeTarget.g;      
  const c=document.getElementById('ep-diffs');c.innerHTML='';      
  const nodes=[{i:Proj.ext.d,o:activeTarget.ext.d},{i:Proj.ext.k,o:activeTarget.ext.k},{i:Proj.ext.p,o:activeTarget.ext.p},{i:Proj.cen.d,o:activeTarget.cen.d},{i:Proj.cen.k,o:activeTarget.cen.k},{i:Proj.cen.p,o:activeTarget.cen.p}];      
  nodes.forEach(n=>{const bad=n.i!==n.o,r=document.createElement('div');r.className='ep-row '+(bad?'bad':'ok');r.innerHTML=`<div class="ep-ln">${n.i===Y?'<div class="ep-dy"></div>':'<div class="ep-dn"><div class="ep-dnb"></div><div class="ep-dnb"></div></div>'}</div><div class="ep-ln">${n.o===Y?'<div class="ep-dy"></div>':'<div class="ep-dn"><div class="ep-dnb"></div><div class="ep-dnb"></div></div>'}</div>`;c.appendChild(r);});      
}      
      
function doSubmit(){      
  if(!isTraining||voidCount()>0)return;      
  const inp=getResolvedSig();isTraining=false;seqIdx++;      
  const ft=document.getElementById('flash-target');ft.textContent=activeTarget.g;ft.classList.add('show');setTimeout(()=>ft.classList.remove('show'),300);      
  sndHex(activeTarget);      
  if(inp===activeTarget){      
    streak++;totalN++;document.getElementById('sv').textContent=streak;document.getElementById('tv').textContent=totalN;      
    sndOK();state='result-ok';applyProj(activeTarget);      
    const yd=document.getElementById('yao-display'),md=document.getElementById('mini-display');      
    yd.classList.remove('glow');md.classList.remove('glow');void yd.offsetWidth;void md.offsetWidth;      
    renderYao();updateMini();yd.classList.add('glow');md.classList.add('glow');      
    updateRight(activeTarget);document.getElementById('panel-right').classList.add('show');      
  }else{      
    const ink=document.getElementById('ink-cloud');ink.classList.add('show');void ink.offsetWidth;ink.classList.remove('show');      
    missed.push(activeTarget);document.getElementById('tv').textContent=totalN;sndFail();state='result-err';showErr(inp);render();      
  }      
  updateFlashBtn();      
}      
function handleFlash(){      
  if(state==='cascade'||state==='flashing')return;      
  switch(state){case'idle':doFlash();break;case'building':doSubmit();break;case'result-ok':case'result-err':clearCont();break;}      
}      
function clearCont(){      
  toggleOff(true);document.getElementById('flash-target').classList.remove('show');      
  document.getElementById('yao-display').classList.remove('glow');document.getElementById('mini-display').classList.remove('glow');      
  hideSP();state='idle';render();      
  if(seqIdx>=seqLen){      
    if(inRem){inRem=false;seq=[];}      
    else if(missed.length>0){seq=[...missed];missed=[];seqIdx=0;seqLen=seq.length;inRem=true;streak=0;document.getElementById('sv').textContent=streak;setTimeout(doFlash,150);return;}      
    else{modeIdx++;const mA=MS[mode];if(modeIdx>=mA.length){startCascade();return;}seqLen=mA[modeIdx];seqIdx=0;seq=[];}      
  }      
  setTimeout(doFlash,150);      
}      
      
function startCascade(){      
  state='cascade';updateFlashBtn();hideSP();      
  document.getElementById('yao-display').classList.remove('glow');document.getElementById('mini-display').classList.remove('glow');      
  cascadeQ=[...SIGS].sort(()=>Math.random()-.5);cascadeIdx=0;playCasc();      
}      
function playCasc(){      
  const ft=document.getElementById('flash-target');      
  if(cascadeIdx>=cascadeQ.length){sndApex();cascadeTimer=setTimeout(()=>{ft.classList.remove('show');advTier();},1600);return;}      
  const sig=cascadeQ[cascadeIdx];ft.textContent=sig.g;ft.classList.add('show');sndHex(sig);cascadeIdx++;      
  cascadeTimer=setTimeout(()=>{ft.classList.remove('show');setTimeout(playCasc,800);},900);      
}      
function advTier(){modeIdx++;if(modeIdx>=MS[mode].length){if(mode==='B')setMode('I');else if(mode==='I')setMode('M');else{state='idle';render();return;}return;}seqLen=MS[mode][modeIdx];state='idle';doReset(true);}      
function doReset(silent){      
  if(!silent)sndReset();if(cascadeTimer){clearTimeout(cascadeTimer);cascadeTimer=null;}      
  isTraining=false;activeTarget=null;seq=[];seqIdx=0;state='idle';cascadeQ=[];cascadeIdx=0;      
  document.getElementById('flash-target').classList.remove('show');document.getElementById('yao-display').classList.remove('glow');document.getElementById('mini-display').classList.remove('glow');      
  hideSP();toggleOff(true);      
}      
function doRestart(){sndRestart();streak=0;totalN=0;missed=[];inRem=false;document.getElementById('sv').textContent=0;document.getElementById('tv').textContent=0;doReset(true);setMode(mode);}      
function setMode(m){if(state==='building')return;mode=m;modeIdx=0;seqLen=MS[m][0];seq=[];seqIdx=0;missed=[];inRem=false;['B','I','M'].forEach(x=>document.getElementById('d'+x).className='db'+(x===m?' on':''));}      
function toggleTheme(){      
  const rt=document.documentElement;      
  rt.dataset.theme=rt.dataset.theme==='light'?'dark':'light';      
  const tb = document.getElementById('theme-btn');      
  if (tb) tb.textContent = rt.dataset.theme === 'light' ? '☽' : 'ש';      
}      
      
document.addEventListener('keydown',e=>{      
  if(e.code==='Space'){e.preventDefault();handleFlash();}      
  if(e.key==='r'||e.key==='R')doReset(false);      
  if(e.key==='4')invertHex();if(e.key==='8')flipTopBottom();if(e.key==='f'||e.key==='F')totalFlip();      
});      
window.addEventListener('resize',sizeDisplay);      
window.onload=()=>{buildGrid();setTimeout(()=>{sizeDisplay();render();},80);};      
</script>      
</body>      
</html>