    actGain.gain.exponentialRampToValueAtTime(0.001,t+dur);      
    actOsc.start(t);actOsc.stop(t+dur+0.1);actVib.stop(t+dur+0.1);      
  }      
  prevFreq=targetFreq;      
}      
